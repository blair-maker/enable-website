on","classes":["s_section-wash-3"],"children":["n0023","n0033"]},{"_id":"n0023","type":"Block","tag":"div","classes":["s_col-15"],"children":["n0024","n0026","n0028"]},{"_id":"n0024","type":"Heading","tag":"h1","classes":["s_h-display"],"children":["n0025"],"data":{"tag":"h1"}},{"_id":"n0025","text":true,"v":"Salesforce, built around what your business actually does."},{"_id":"n0026","type":"Paragraph","tag":"p","classes":["s_body-lg-3"],"children":["n0027"]},{"_id":"n0027","text":true,"v":"Sales Cloud, Service Cloud, Data 360, Agentforce and Agentforce Marketing, delivered by senior practitioners who ask what you are trying to do before opening the platform."},{"_id":"n0028","type":"Block","tag":"div","classes":["s_row-6"],"children":["n0029","n0031"]},{"_id":"n0029","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0030"],"data":{"link":{"mode":"external","url":"#cta"}}},{"_id":"n0030","text":true,"v":"Book a discovery call"},{"_id":"n0031","type":"Link","tag":"a","classes":["s_btn-outline"],"children":["n0032"],"data":{"link":{"mode":"external","url":"/waypoint"}}},{"_id":"n0032","text":true,"v":"See Waypoint"},{"_id":"n0033","type":"Block","tag":"div","classes":["s_card-float-6"],"children":["n0034","n0036","n0045"]},{"_id":"n0034","type":"Block","tag":"div","classes":["s_wrap-3"],"children":["n0035"]},{"_id":"n0035","text":true,"v":"Before we open Salesforce"},{"_id":"n0036","type":"Block","tag":"div","classes":["s_stack-5"],"children":["n0037","n0039","n0041","n0043"]},{"_id":"n0037","type":"Paragraph","tag":"p","classes":["s_body-md-2"],"children":["n0038"]},{"_id":"n0038","text":true,"v":"What are you trying to do?"},{"_id":"n0039","type":"Paragraph","tag":"p","classes":["s_body-md-2"],"children":["n0040"]},{"_id":"n0040","text":true,"v":"Who is the work actually for?"},{"_id":"n0041","type":"Paragraph","tag":"p","classes":["s_body-md-2"],"children":["n0042"]},{"_id":"n0042","text":true,"v":"What has already been tried?"},{"_id":"n0043","type":"Paragraph","tag":"p","classes":["s_body-md-2"],"children":["n0044"]},{"_id":"n0044","text":true,"v":"What happens if nothing changes?"},{"_id":"n0045","type":"Paragraph","tag":"p","classes":["s_body-sm-5"],"children":["n0046"]},{"_id":"n0046","text":true,"v":"A lot of the time the answer is not a new feature. It is a clearer view of the problem."},{"_id":"n0047","type":"Section","tag":"section","classes":["s_section-3"],"children":["n0048","n0054"]},{"_id":"n0048","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0049","n0052"]},{"_id":"n0049","type":"Block","tag":"div","classes":["s_col-5"],"children":["n0050"]},{"_id":"n0050","type":"Heading","tag":"h2","classes":["s_h-section"],"children":["n0051"],"data":{"tag":"h2"}},{"_id":"n0051","text":true,"v":"Five practices, one team, no handover between them."},{"_id":"n0052","type":"Paragraph","tag":"p","classes":["s_body-lead-2"],"children":["n0053"]},{"_id":"n0053","text":true,"v":"Most projects touch more than one of these, and the seams are where things usually go wrong. The same people work across all five, so the conversation about how marketing data reaches a service agent happens in the room rather than between two firms."},{"_id":"n0054","type":"Block","tag":"div","classes":["s_grid-3-2"],"children":["n0055","n0060","n0065","n0070","n0075","n0080"]},{"_id":"n0055","type":"Block","tag":"div","classes":["s_card-gradient-blue"],"children":["n0056","n0058"]},{"_id":"n0056","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0057"],"data":{"tag":"h3"}},{"_id":"n0057","text":true,"v":"Sales Cloud"},{"_id":"n0058","type":"Paragraph","tag":"p","classes":["s_body-sm-4"],"children":["n0059"]},{"_id":"n0059","text":true,"v":"Pipeline that matches how your team actually sells, stages that mean something, and a forecast your CFO will not laugh at. Territory, quoting and partner management where the model needs them."},{"_id":"n0060","type":"Block","tag":"div","classes":["s_card-gradient-blue"],"children":["n0061","n0063"]},{"_id":"n0061","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0062"],"data":{"tag":"h3"}},{"_id":"n0062","text":true,"v":"Service Cloud"},{"_id":"n0063","type":"Paragraph","tag":"p","classes":["s_body-sm-4"],"children":["n0064"]},{"_id":"n0064","text":true,"v":"Case management, Omni-Channel routing, knowledge and entitlements. Built so the person answering knows what they are looking at, and so the SLA reflects an actual commitment."},{"_id":"n0065","type":"Block","tag":"div","classes":["s_card-gradient-navy-2"],"children":["n0066","n0068"]},{"_id":"n0066","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0067"],"data":{"tag":"h3"}},{"_id":"n0067","text":true,"v":"Data 360"},{"_id":"n0068","type":"Paragraph","tag":"p","classes":["s_body-sm-6"],"children":["n0069"]},{"_id":"n0069","text":true,"v":"The single customer view you keep being told you have. Identity resolution, calculated insights, activations into everything else, and honest modelling of what the credits will cost before you commit."},{"_id":"n0070","type":"Block","tag":"div","classes":["s_card-gradient-cyan"],"children":["n0071","n0073"]},{"_id":"n0071","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0072"],"data":{"tag":"h3"}},{"_id":"n0072","text":true,"v":"Agentforce"},{"_id":"n0073","type":"Paragraph","tag":"p","classes":["s_body-sm-7"],"children":["n0074"]},{"_id":"n0074","text":true,"v":"Agents doing real work: deflecting cases, supporting sellers, running the internal jobs nobody got to. Designed, grounded, guardrailed and evaluated against actual cases before anything reaches a customer."},{"_id":"n0075","type":"Block","tag":"div","classes":["s_card-gradient-teal"],"children":["n0076","n0078"]},{"_id":"n0076","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0077"],"data":{"tag":"h3"}},{"_id":"n0077","text":true,"v":"Agentforce Marketing"},{"_id":"n0078","type":"Paragraph","tag":"p","classes":["s_body-sm-8"],"children":["n0079"]},{"_id":"n0079","text":true,"v":"Marketing Cloud Next on the core platform. Audiences from Data 360, journeys built in Flow, and campaigns that do not read like a 2014 email blast. Migration from SFMC or Pardot where that is the starting point."},{"_id":"n0080","type":"Block","tag":"div","classes":["s_card-mist-8"],"children":["n0081","n0083"]},{"_id":"n0081","type":"Heading","tag":"h3","classes":["s_h-card-2"],"children":["n0082"],"data":{"tag":"h3"}},{"_id":"n0082","text":true,"v":"And the parts around them"},{"_id":"n0083","type":"Paragraph","tag":"p","classes":["s_body-sm"],"children":["n0084"]},{"_id":"n0084","text":true,"v":"Integration, migration, sharing and security models, Experience Cloud, Tableau, and the governance that keeps an org from turning into a museum. Rarely the headline, usually the reason a project lands."},{"_id":"n0085","type":"Section","tag":"section","classes":["s_section-mist-3"],"children":["n0086","n0089"]},{"_id":"n0086","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0087"]},{"_id":"n0087","type":"Heading","tag":"h2","classes":["s_h-section"],"children":["n0088"],"data":{"tag":"h2"}},{"_id":"n0088","text":true,"v":"Business first. Salesforce second."},{"_id":"n0089","type":"Block","tag":"div","classes":["s_stack-4"],"children":["n0090","n0097","n0104","n0111"]},{"_id":"n0090","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0091","n0093","n0095"]},{"_id":"n0091","type":"Block","tag":"div","classes":["s_row"],"children":["n0092"]},{"_id":"n0092","text":true,"v":"01"},{"_id":"n0093","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0094"],"data":{"tag":"h3"}},{"_id":"n0094","text":true,"v":"Understand the problem"},{"_id":"n0095","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0096"]},{"_id":"n0096","text":true,"v":"Before we open Salesforce we want to know what you are trying to do, who the work is for, and what has already been tried. Sometimes the answer is a major build. Sometimes it is a small change. Sometimes it is that Salesforce is not the right tool at all, and we will say so."},{"_id":"n0097","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0098","n0100","n0102"]},{"_id":"n0098","type":"Block","tag":"div","classes":["s_row"],"children":["n0099"]},{"_id":"n0099","text":true,"v":"02"},{"_id":"n0100","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0101"],"data":{"tag":"h3"}},{"_id":"n0101","text":true,"v":"Scope it honestly"},{"_id":"n0102","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0103"]},{"_id":"n0103","text":true,"v":"Fixed scope, fixed price and fixed date wherever the work allows it, agreed before anything starts. No padded hours, no surprise invoices, and nothing on the bill you cannot point to. Where genuine uncertainty exists it goes in the assumptions, not scattered through the scope."},{"_id":"n0104","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0105","n0107","n0109"]},{"_id":"n0105","type":"Block","tag":"div","classes":["s_row"],"children":["n0106"]},{"_id":"n0106","text":true,"v":"03"},{"_id":"n0107","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0108"],"data":{"tag":"h3"}},{"_id":"n0108","text":true,"v":"Build it ourselves"},{"_id":"n0109","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0110"]},{"_id":"n0110","text":true,"v":"The people you meet are the people who do the work. No bench of juniors, and no handing your project to someone you have never spoken to. Senior practitioners from the first call through to the handover."},{"_id":"n0111","type":"Block","tag":"div","classes":["s_row-8"],"children":["n0112","n0114","n0116"]},{"_id":"n0112","type":"Block","tag":"div","classes":["s_row"],"children":["n0113"]},{"_id":"n0113","text":true,"v":"04"},{"_id":"n0114","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0115"],"data":{"tag":"h3"}},{"_id":"n0115","text":true,"v":"Hand it over properly"},{"_id":"n0116","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0117"]},{"_id":"n0117","text":true,"v":"Configuration documentation, change and decision registers, training material and user guides, written on the assumption you may never need to call us again. If you want to keep improving it from there, that is what Waypoint is for."},{"_id":"n0118","type":"Section","tag":"section","classes":["s_row-split-8"],"children":["n0119","n0121"]},{"_id":"n0119","type":"Block","tag":"div","classes":["s_wrap-11"],"children":["n0120"]},{"_id":"n0120","text":true,"v":"Delivered for organisations across"},{"_id":"n0121","type":"Block","tag":"div","classes":["s_row-wrap-2"],"children":["n0122","n0124","n0126","n0128","n0130"]},{"_id":"n0122","type":"Block","tag":"div","classes":["s_tag"],"children":["n0123"]},{"_id":"n0123","text":true,"v":"Financial services"},{"_id":"n0124","type":"Block","tag":"div","classes":["s_tag"],"children":["n0125"]},{"_id":"n0125","text":true,"v":"Emergency services"},{"_id":"n0126","type":"Block","tag":"div","classes":["s_tag"],"children":["n0127"]},{"_id":"n0127","text":true,"v":"Heritage"},{"_id":"n0128","type":"Block","tag":"div","classes":["s_tag"],"children":["n0129"]},{"_id":"n0129","text":true,"v":"Retirement living"},{"_id":"n0130","type":"Block","tag":"div","classes":["s_tag"],"children":["n0131"]},{"_id":"n0131","text":true,"v":"Agri-tech"},{"_id":"n0132","type":"Section","tag":"section","classes":["s_section-wash"],"children":["n0133","n0140"]},{"_id":"n0133","type":"Block","tag":"div","classes":["s_col-4"],"children":["n0134","n0136","n0138"]},{"_id":"n0134","type":"Heading","tag":"h2","classes":["s_h-cta"],"children":["n0135"],"data":{"tag":"h2"}},{"_id":"n0135","text":true,"v":"Let's talk about your business first."},{"_id":"n0136","type":"Paragraph","tag":"p","classes":["s_body-md"],"children":["n0137"]},{"_id":"n0137","text":true,"v":"We would rather have a useful conversation than win a project that should not have happened. That goes for scope, for timing, and for whether the platform fits at all."},{"_id":"n0138","type":"Paragraph","tag":"p","classes":["s_caption"],"children":["n0139"]},{"_id":"n0139","text":true,"v":"Blair Rooney, Managing Director. blair@enabledigital.co, +64 22 226 4252. Auckland and Wellington."},{"_id":"n0140","type":"Link","tag":"a","classes":["s_btn-primary-4"],"children":["n0141"],"data":{"link":{"mode":"external","url":"#top"}}},{"_id":"n0141","text":true,"v":"Book a discovery call"},{"_id":"n0142","type":"Block","tag":"footer","classes":["s_stack-3"],"children":["n0143","n0190"]},{"_id":"n0143","type":"Block","tag":"div","classes":["s_row-7"],"children":["n0144","n0153"]},{"_id":"n0144","type":"Block","tag":"div","classes":["s_col-3"],"children":["n0145","n0146","n0148"]},{"_id":"n0145","type":"Block","tag":"div","classes":["s_col"],"children":[]},{"_id":"n0146","type":"Paragraph","tag":"p","classes":["s_body-sm"],"children":["n0147"]},{"_id":"n0147","text":true,"v":"A Salesforce consultancy in Auckland and Wellington, working across every layer of the stack."},{"_id":"n0148","type":"Block","tag":"div","classes":["s_badge-slot"],"children":["n0149","n0151"]},{"_id":"n0149","type":"Block","tag":"div","classes":["s_wrap-4"],"children":["n0150"]},{"_id":"n0150","text":true,"v":"Salesforce Partner badge"},{"_id":"n0151","type":"Block","tag":"div","classes":["s_wrap-5"],"children":["n0152"]},{"_id":"n0152","text":true,"v":"168 \u00d7 97, ratio 1.74:1"},{"_id":"n0153","type":"Block","tag":"div","classes":["s_grid-4"],"children":["n0154","n0163","n0172","n0181"]},{"_id":"n0154","type":"Block","tag":"div","classes":["s_stack"],"children":["n0155","n0157","n0159","n0161"]},{"_id":"n0155","type":"Block","tag":"div","classes":["s_wrap-3"],"children":["n0156"]},{"_id":"n0156","text":true,"v":"Services"},{"_id":"n0157","type":"Link","tag":"a","classes":["s_wrap"],"chi