":"n0084","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0085"]},{"_id":"n0085","type":"Heading","tag":"h2","classes":["s_h-section-2"],"children":["n0086"],"data":{"tag":"h2"}},{"_id":"n0086","text":true,"v":"However you would rather start"},{"_id":"n0087","type":"Block","tag":"div","classes":["s_grid-3"],"children":["n0088","n0093","n0098"]},{"_id":"n0088","type":"Block","tag":"div","classes":["s_card-float-4"],"children":["n0089","n0091"]},{"_id":"n0089","type":"Heading","tag":"h3","classes":["s_h-item-3"],"children":["n0090"],"data":{"tag":"h3"}},{"_id":"n0090","text":true,"v":"Talk to Blair directly"},{"_id":"n0091","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0092"]},{"_id":"n0092","text":true,"v":"Blair Rooney, Managing Director. blair@enabledigital.co, +64 22 226 4252. The people you meet are the people who do the work, which starts with this call."},{"_id":"n0093","type":"Block","tag":"div","classes":["s_card-float-4"],"children":["n0094","n0096"]},{"_id":"n0094","type":"Heading","tag":"h3","classes":["s_h-item-3"],"children":["n0095"],"data":{"tag":"h3"}},{"_id":"n0095","text":true,"v":"Where we work"},{"_id":"n0096","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0097"]},{"_id":"n0097","text":true,"v":"Auckland and Wellington, working with organisations across New Zealand and Australia. On site when it helps, remote when it does not."},{"_id":"n0098","type":"Block","tag":"div","classes":["s_card-float-4"],"children":["n0099","n0101"]},{"_id":"n0099","type":"Heading","tag":"h3","classes":["s_h-item-3"],"children":["n0100"],"data":{"tag":"h3"}},{"_id":"n0100","text":true,"v":"What it costs to ask"},{"_id":"n0101","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0102"]},{"_id":"n0102","text":true,"v":"Nothing. A first conversation is not a sales process, and we would rather tell you early that something is not worth doing than find out together in month four."},{"_id":"n0103","type":"Section",