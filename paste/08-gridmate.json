=\"242\" y=\"116\" width=\"118\" height=\"26\" rx=\"6\" fill=\"#ffffff\" stroke=\"#1EE885\" stroke-width=\"2\"/><text x=\"252\" y=\"129\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Closed Won</text><rect x=\"349\" y=\"120\" width=\"1.5\" height=\"18\" fill=\"#0C2B4B\"/><text x=\"466\" y=\"129\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#0C2B4B\" text-anchor=\"end\" dominant-baseline=\"middle\">$67,500</text><rect x=\"0\" y=\"150\" width=\"480\" height=\"34\" rx=\"8\" fill=\"#E8FCF2\"/><rect x=\"0\" y=\"150\" width=\"3\" height=\"34\" rx=\"2\" fill=\"#1EE885\"/><text x=\"14\" y=\"167\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Awatere Wines</text><text x=\"250\" y=\"167\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#5D7290\" dominant-baseline=\"middle\">Discovery</text><text x=\"466\" y=\"167\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#0C2B4B\" text-anchor=\"end\" dominant-baseline=\"middle\">$21,400</text><rect x=\"0\" y=\"188\" width=\"480\" height=\"34\" rx=\"8\" fill=\"#ffffff\" stroke=\"#DCE6F0\"/><text x=\"14\" y=\"205\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Pukeko Labs</text><text x=\"250\" y=\"205\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#5D7290\" dominant-baseline=\"middle\">Proposal</text><text x=\"466\" y=\"205\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#0C2B4B\" text-anchor=\"end\" dominant-baseline=\"middle\">$9,800</text><rect x=\"0\" y=\"234\" width=\"150\" height=\"28\" rx=\"4\" fill=\"#0A6B44\"/><text x=\"75\" y=\"248\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" font-weight=\"600\" fill=\"#ffffff\" text-anchor=\"middle\" dominant-baseline=\"middle\">3 rows \u00b7 edit all</text><text x=\"164\" y=\"248\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" fill=\"#5D7290\" dominant-baseline=\"middle\">No export. No reimport. No merge conflict.</text></svg>"}},"insideRTE":false}},{"_id":"n0038","type":"Paragraph","tag":"p","classes":["s_caption-sm-2"],"children":["n0039"]},{"_id":"n0039","text":true,"v":"The screen your team currently exports. This is the one worth rebuilding first."},{"_id":"n0040","type":"Section","tag":"section","classes":["s_row-split-5"],"children":["n0041","n0043"]},{"_id":"n0041","type":"Block","tag":"div","classes":["s_caption-2"],"children":["n0042"]},{"_id":"n0042","text":true,"v":"A Salesforce ISV on the AppExchange since 2019"},{"_id":"n0043","type":"Block","tag":"div","classes":["s_row-14"],"children":["n0044","n0046","n0048","n0050"]},{"_id":"n0044","type":"Block","tag":"div","classes":["s_tag"],"children":["n0045"]},{"_id":"n0045","text":true,"v":"32 components"},{"_id":"n0046","type":"Block","tag":"div","classes":["s_tag"],"children":["n0047"]},{"_id":"n0047","text":true,"v":"5 stars, 100+ reviews"},{"_id":"n0048","type":"Block","tag":"div","classes":["s_tag"],"children":["n0049"]},{"_id":"n0049","text":true,"v":"165,000+ users"},{"_id":"n0050","type":"Block","tag":"div","classes":["s_tag"],"children":["n0051"]},{"_id":"n0051","text":true,"v":"550+ organisations"},{"_id":"n0052","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0053","n0059"]},{"_id":"n0053","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0054","n0057"]},{"_id":"n0054","type":"Block","tag":"div","classes":["s_col-5"],"children":["n0055"]},{"_id":"n0055","type":"Heading","tag":"h2","classes":["s_h-section"],"children":["n0056"],"data":{"tag":"h2"}},{"_id":"n0056","text":true,"v":"Thirty-two components, aimed squarely at the reasons people leave Salesforce."},{"_id":"n0057","type":"Paragraph","tag":"p","classes":["s_body-lead-2"],"children":["n0058"]},{"_id":"n0058","text":true,"v":"Every export to Excel is a small vote against the platform, and a data quality problem waiting to happen. GridMate removes the reason for the export rather than writing a policy against it."},{"_id":"n0059","type":"Block","tag":"div","classes":["s_grid-4-2"],"children":["n0060","n0065","n0070","n0075"]},{"_id":"n0060","type":"Block","tag":"div","classes":["s_card-gradient-teal-3"],"children":["n0061","n0063"]},{"_id":"n0061","type":"Heading","tag":"h3","classes":["s_h-item-2"],"children":["n0062"],"data":{"tag":"h3"}},{"_id":"n0062","text":true,"v":"Grids and inline editing"},{"_id":"n0063","type":"Paragraph","tag":"p","classes":["s_body-sm-9"],"children":["n0064"]},{"_id":"n0064","text":true,"v":"User Grid, Pivot Grid, List View Grid and Related List Grid. Update many fields and record types at once, with four levels of filtering, grouping and sorting."},{"_id":"n0065","type":"Block","tag":"div","classes":["s_card-gradient-cyan-3"],"children":["n0066","n0068"]},{"_id":"n0066","type":"Heading","tag":"h3","classes":["s_h-item-2"],"children":["n0067"],"data":{"tag":"h3"}},{"_id":"n0067","text":true,"v":"Calendars and Gantt"},{"_id":"n0068","type":"Paragraph","tag":"p","classes":["s_body-sm-10"],"children":["n0069"]},{"_id":"n0069","text":true,"v":"Multi, single and compact calendars plus a Gantt chart, for teams scheduling work against records rather than in a separate tool."},{"_id":"n0070","type":"Block","tag":"div","classes":["s_card-gradient-blue-3"],"children":["n0071","n0073"]},{"_id":"n0071","type":"Heading","tag":"h3","classes":["s_h-item-2"],"children":["n0072"],"data":{"tag":"h3"}},{"_id":"n0072","text":true,"v":"Kanban and maps"},{"_id":"n0073","type":"Paragraph","tag":"p","classes":["s_body-sm-11"],"children":["n0074"]},{"_id":"n0074","text":true,"v":"Kanban boards on list views and field sets, map lists and record maps, for work that is easier to see as a board or a territory than as a table."},{"_id":"n0075","type":"Block","tag":"div","classes":["s_card-gradient-navy-3"],"children":["n0076","n0078"]},{"_id":"n0076","type":"Heading","tag":"h3","classes":["s_h-item-2"],"children":["n0077"],"data":{"tag":"h3"}},{"_id":"n0077","text":true,"v":"Layout and navigation"},{"_id":"n0078","type":"Paragraph","tag":"p","classes":["s_body-sm-12"],"children":["n0079"]},{"_id":"n0079","text":true,"v":"Record cards, object timelines, dynamic tabs and accordions, and a file explorer. Related records visible and editable without switching tab."},{"_id":"n0080","type":"Section","tag":"section","classes":["s_section-7"],"children":["n0081","n0090"]},{"_id":"n0081","type":"Block","tag":"div","classes":["s_col-25"],"children":["n0082","n0084","n0086"]},{"_id":"n0082","type":"Heading","tag":"h2","classes":["s_h-section-sm-4"],"children":["n0083"],"data":{"tag":"h2"}},{"_id":"n0083","text":true,"v":"RevenueMate, from the same team"},{"_id":"n0084","type":"Paragraph","tag":"p","classes":["s_body-md-7"],"children":["n0085"]},{"_id":"n0085","text":true,"v":"Salesforce CPQ has entered end-of-sale, and mid-market organisations now need a path that is not a Revenue Cloud programme. RevenueMate is a Salesforce-native CPQ built by the GridMate team, aimed at exactly that gap: enterprise capability without the implementation that usually comes with it."},{"_id":"n0086","type":"Block","tag":"div","classes":["s_card-mist-10"],"children":["n0087"]},{"_id":"n0087","type":"Paragraph","tag":"p","classes":["s_body-sm-13"],"children":["n0088"]},{"_id":"n0088","type":"Block","tag":"div","classes":[],"children":["n0089"]},{"_id":"n0089","text":true,"v":"Where this stands."},{"_id":"n0090","type":"Block","tag":"div","classes":["s_grid-2-5"],"children":["n0091","n0096","n0101","n0106"]},{"_id":"n0091","type":"Block","tag":"div","classes":["s_card-5"],"children":["n0092","n0094"]},{"_id":"n0092","type":"Heading","tag":"h3","classes":["s_h-item-sm"],"children":["n0093"],"data":{"tag":"h3"}},{"_id":"n0093","text":true,"v":"Sub-second pricing"},{"_id":"n0094","type":"Paragraph","tag":"p","classes":["s_body-sm-2"],"children":["n0095"]},{"_id":"n0095","text":true,"v":"Complex quotes priced without the wait that makes sellers quote in a spreadsheet instead."},{"_id":"n0096","type":"Block","tag":"div","classes":["s_card-5"],"children":["n0097","n0099"]},{"_id":"n0097","type":"Heading","tag":"h3","classes":["s_h-item-sm"],"children":["n0098"],"data":{"tag":"h3"}},{"_id":"n0098","text":true,"v":"Nested bundle configurator"},{"_id":"n0099","type":"Paragraph","tag":"p","classes":["s_body-sm-2"],"children":["n0100"]},{"_id":"n0100","text":true,"v":"Product configuration for real catalogues, with a customisable pricing rules engine behind it."},{"_id":"n0101","type":"Block","tag":"div","classes":["s_card-5"],"children":["n0102","n0104"]},{"_id":"n0102","type":"Heading","tag":"h3","classes":["s_h-item-sm"],"children":["n0103"],"data":{"tag":"h3"}},{"_id":"n0103","text":true,"v":"Margin visible while quoting"},{"_id":"n0104","type":"Paragraph","tag":"p","classes":["s_body-sm-2"],"children":["n0105"]},{"_id":"n0105","text":true,"v":"Real-time margin on the quote, so discount conversations happen before approval rather than after."},{"_id":"n0106","type":"Block","tag":"div","classes":["s_card-5"],"children":["n0107","n0109"]},{"_id":"n0107","type":"Heading","tag":"h3","classes":["s_h-item-sm"],"children":["n0108"],"data":{"tag":"h3"}},{"_id":"n0108","text":true,"v":"Approvals, audit and signing"},{"_id":"n0109","type":"Paragraph","tag":"p","classes":["s_body-sm-2"],"children":["n0110"]},{"_id":"n0110","text":true,"v":"Multi-level approval workflows, full audit trails, and vendor-agnostic e-signature. Lumin slots in here."},{"_id":"n0111","type":"Section","tag":"section","classes":["s_section-wash-5"],"children":["n0112","n0117"]},{"_id":"n0112","type":"Block","tag":"div","classes":["s_col-10"],"children":["n0113","n0115"]},{"_id":"n0113","type":"Heading","tag":"h2","classes":["s_h-section-sm-5"],"children":["n0114"],"data":{"tag":"h2"}},{"_id":"n0114","text":true,"v":"Components are cheap. Deciding where they belong is the work."},{"_id":"n0115","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0116"]},{"_id":"n0116","text":true,"v":"Dropping 32 components onto every page makes an org worse, not better. We work out which views actually cause the spreadsheet exports, and fix those."},{"_id":"n0117","type":"Block","tag":"div","classes":["s_grid-2-2"],"children":["n0118","n0123","n0128","n0133"]},{"_id":"n0118","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0119","n0121"]},{"_id":"n0119","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0120"],"data":{"tag":"h3"}},{"_id":"n0120","text":true,"v":"Find the actual friction"},{"_id":"n0121","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0122"]},{"_id":"n0122","text":true,"v":"We watch how your team really works and find the three or four screens where people give up and export. Those are the ones worth rebuilding."},{"_id":"n0123","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0124","n0126"]},{"_id":"n0124","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0125"],"data":{"tag":"h3"}},{"_id":"n0125","text":true,"v":"Configure to the role"},{"_id":"n0126","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0127"]},{"_id":"n0127","text":true,"v":"A grid for a service team and a grid for a finance team are different grids. Filters, columns, permissions and record-type behaviour set per role."},{"_id":"n0128","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0129","n0131"]},{"_id":"n0129","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0130"],"data":{"tag":"h3"}},{"_id":"n0130","text":true,"v":"Protect the data model"},{"_id":"n0131","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0132"]},{"_id":"n0132","text":true,"v":"Bulk editing is powerful in both directions. Validation, field-level security and sharing checked before anyone can change forty records at once."},{"_id":"n0133","type":"Block","tag":"div","