lasses":["s_section-wash-2"],"children":["n0023","n0033"]},{"_id":"n0023","type":"Block","tag":"div","classes":["s_col-8"],"children":["n0024","n0026","n0028"]},{"_id":"n0024","type":"Heading","tag":"h1","classes":["s_h-display"],"children":["n0025"],"data":{"tag":"h1"}},{"_id":"n0025","text":true,"v":"Moving from the Nonprofit Success Pack to Nonprofit Cloud."},{"_id":"n0026","type":"Paragraph","tag":"p","classes":["s_body-lg"],"children":["n0027"]},{"_id":"n0027","text":true,"v":"NPSP remains supported and Salesforce has announced no forced end date. That makes this a decision rather than a deadline, which is the best possible time to make it carefully. Start with an assessment, not a migration plan."},{"_id":"n0028","type":"Block","tag":"div","classes":["s_row-6"],"children":["n0029","n0031"]},{"_id":"n0029","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0030"],"data":{"link":{"mode":"external","url":"/contact"}}},{"_id":"n0030","text":true,"v":"Book the assessment"},{"_id":"n0031","type":"Link","tag":"a","classes":["s_btn-outline"],"children":["n0032"],"data":{"link":{"mode":"external","url":"#changes"}}},{"_id":"n0032","text":true,"v":"What changes"},{"_id":"n0033","type":"Block","tag":"div","classes":["s_card-float"],"children":["n0034","n0037","n0038"]},{"_id":"n0034","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0035"]},{"_id":"n0035","type":"Block","tag":"div","classes":["s_wrap-3"],"children":["n0036"]},{"_id":"n0036","text":true,"v":"What actually changes"},{"_id":"n0037","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg viewBox=\"0 0 480 306\" width=\"100%\" style=\"display: block; overflow: visible;\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\"><defs><marker id=\"ah\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0.8 L7.5 4 L0 7.2 Z\" fill=\"#C5D6E8\"/></marker></defs><text x=\"0\" y=\"12\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#5D7290\" text-anchor=\"start\">NPSP</text><text x=\"480\" y=\"12\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#0A6B44\" text-anchor=\"end\">Nonprofit Cloud</text><rect x=\"0\" y=\"30\" width=\"196\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><text x=\"98\" y=\"51\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Household Account</text><path d=\"M 204 51 L 276 51\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.6\" marker-end=\"url(#ah)\"/><rect x=\"284\" y=\"30\" width=\"4\" height=\"42\" rx=\"2\" fill=\"#12795A\"/><rect x=\"288\" y=\"30\" width=\"192\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><rect x=\"288\" y=\"30\" width=\"8\" height=\"42\" fill=\"#F4F8FC\"/><text x=\"300\" y=\"51.0\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Person Account</text><rect x=\"0\" y=\"84\" width=\"196\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><text x=\"98\" y=\"105\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Opportunity</text><path d=\"M 204 105 L 276 105\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.6\" marker-end=\"url(#ah)\"/><rect x=\"284\" y=\"84\" width=\"4\" height=\"42\" rx=\"2\" fill=\"#12795A\"/><rect x=\"288\" y=\"84\" width=\"192\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><rect x=\"288\" y=\"84\" width=\"8\" height=\"42\" fill=\"#F4F8FC\"/><text x=\"300\" y=\"105.0\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Gift Transaction</text><rect x=\"0\" y=\"138\" width=\"196\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><text x=\"98\" y=\"159\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Recurring Donation</text><path d=\"M 204 159 L 276 159\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.6\" marker-end=\"url(#ah)\"/><rect x=\"284\" y=\"138\" width=\"4\" height=\"42\" rx=\"2\" fill=\"#12795A\"/><rect x=\"288\" y=\"138\" width=\"192\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><rect x=\"288\" y=\"138\" width=\"8\" height=\"42\" fill=\"#F4F8FC\"/><text x=\"300\" y=\"159.0\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Gift Commitment</text><rect x=\"0\" y=\"192\" width=\"196\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><text x=\"98\" y=\"213\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">GAU Allocation</text><path d=\"M 204 213 L 276 213\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.6\" marker-end=\"url(#ah)\"/><rect x=\"284\" y=\"192\" width=\"4\" height=\"42\" rx=\"2\" fill=\"#12795A\"/><rect x=\"288\" y=\"192\" width=\"192\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><rect x=\"288\" y=\"192\" width=\"8\" height=\"42\" fill=\"#F4F8FC\"/><text x=\"300\" y=\"213.0\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Gift Designation</text><rect x=\"0\" y=\"246\" width=\"196\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><text x=\"98\" y=\"267\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Customizable Rollups</text><path d=\"M 204 267 L 276 267\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.6\" marker-end=\"url(#ah)\"/><rect x=\"284\" y=\"246\" width=\"4\" height=\"42\" rx=\"2\" fill=\"#12795A\"/><rect x=\"288\" y=\"246\" width=\"192\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><rect x=\"288\" y=\"246\" width=\"8\" height=\"42\" fill=\"#F4F8FC\"/><text x=\"300\" y=\"267.0\" font-family=\"Inter, sans-serif\" font-size=\"12.5\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Data Processing Engine</text></svg>"}},"insideRTE":false}},{"_id":"n0038","type":"Paragraph","tag":"p","classes":["s_caption-sm-2"],"children":["n0039"]},{"_id":"n0039","text":true,"v":"The model underneath is different, which is why this is a rebuild rather than a data load."},{"_id":"n0040","type":"Section","tag":"section","classes":["s_card-tint-5"],"children":["n0041","n0043"]},{"_id":"n0041","type":"Heading","tag":"h2","classes":["s_h-card-lg-4"],"children":["n0042"],"data":{"tag":"h2"}},{"_id":"n0042","text":true,"v":"Where we stand on this"},{"_id":"n0043","type":"Paragraph","tag":"p","classes":["s_body-md-3"],"children":["n0044"]},{"_id":"n0044","text":true,"v":"Enable has years of Salesforce nonprofit experience and delivers Nonprofit Cloud today. NPSP migration is an offering we are bringing to market now, rather than a decade-long track record we are going to claim. What that means in practice: the assessment is priced small and sold on its own, the findings are yours whether or not you continue, and we will tell you plainly where the ground is new for everyone."},{"_id":"n0045","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0046","n0051"]},{"_id":"n0046","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0047","n0049"]},{"_id":"n0047","type":"Heading","tag":"h2","classes":["s_h-section-3"],"children":["n0048"],"data":{"tag":"h2"}},{"_id":"n0048","text":true,"v":"The first question is whether to move at all"},{"_id":"n0049","type":"Paragraph","tag":"p","classes":["s_body-lead"],"children":["n0050"]},{"_id":"n0050","text":true,"v":"Plenty of organisations are running NPSP well and should keep doing so for now. The cost of moving is real, and a migration undertaken because of a rumour about end-of-life is a migration done for the wrong reason."},{"_id":"n0051","type":"Block","tag":"div","classes":["s_grid-3"],"children":["n0052","n0058","n0064"]},{"_id":"n0052","type":"Block","tag":"div","classes":["s_card-bordered"],"children":["n0053","n0054","n0056"]},{"_id":"n0053","type":"Block","tag":"div","classes":["s_btn-primary-3"],"children":[]},{"_id":"n0054","type":"Heading","tag":"h3","classes":["s_wrap-23"],"children":["n0055"],"data":{"tag":"h3"}},{"_id":"n0055","text":true,"v":"Reasons to move now"},{"_id":"n0056","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0057"]},{"_id":"n0057","text":true,"v":"You need programme, case or outcome management and are currently bolting it on. You are buying new Salesforce capability that assumes core objects. Your customisation of NPSP has become the thing that blocks every upgrade."},{"_id":"n0058","type":"Block","tag":"div","classes":["s_card-bordered"],"children":["n0059","n0060","n0062"]},{"_id":"n0059","type":"Block","tag":"div","classes":["s_btn-primary-3"],"children":[]},{"_id":"n0060","type":"Heading","tag":"h3","classes":["s_wrap-23"],"children":["n0061"],"data":{"tag":"h3"}},{"_id":"n0061","text":true,"v":"Reasons to wait"},{"_id":"n0062","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0063"]},{"_id":"n0063","text":true,"v":"NPSP is doing what you need, your customisation is light, and the money would do more good spent on the mission this year. Waiting is a legitimate answer and we will give it where it is the right one."},{"_id":"n0064","type":"Block","tag":"div","classes":["s_card-bordered"],"children":["n0065","n0066","n0068"]},{"_id":"n0065","type":"Block","tag":"div","classes":["s_btn-primary-3"],"children":[]},{"_id":"n0066","type":"Heading","tag":"h3","classes":["s_wrap-23"],"children":["n0067"],"data":{"tag":"h3"}},{"_id":"n0067","text":true,"v":"Reasons it is not the real problem"},{"_id":"n0068","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0069"]},{"_id":"n0069","text":true,"v":"If reporting is wrong, adoption is poor or data quality is bad, those follow you across. A migration is an expensive way to discover that the problem was the process. We would rather find that first."},{"_id":"n0070","type":"Section","tag":"section","classes":["s_section"],"children":["n0071","n0076"]},{"_id":"n0071","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0072","n0074"]},{"_id":"n0072","type":"Heading","tag":"h2","classes":["s_h-section-3"],"children":["n0073"],"data":{"tag":"h2"}},{"_id":"n0073","text":true,"v":"What actually changes"},{"_id":"n0074","type":"Paragraph","tag":"p","classes":["s_body-lead"],"children":["n0075"]},{"_id":"n0075","text":true,"v":"Not a rename. The data model underneath is different, which is why a migration is a rebuild of your fundraising operation rather than a data load."},{"_id":"n0076","type":"Block","tag":"div","classes":["s_stack-4"],"children":["n0077","n0083","n0089","n0095","n0101","n0107","n0113","n0119"]},{"_id":"n0077","type":"Block","tag":"div","classes":["s_row-9"],"children":["n0078","n0080","n0081"]},{"_id":"n0078","type":"Block","tag":"div","classes":["s_wrap-9"],"children":["n0079"]},{"_id":"n0079","text":true,"v":"A managed package sitting on Sales Cloud"},{"_id":"n0080","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex-shrink: 0; margin-top: 2px;\"><path d=\"M5 12h14\"/><path d=\"M13 6l6 6-6 6\"/></svg>"}},"insideRTE":false}},{"_id":"n0081","type":"Block","tag":"div","classes":["s_wrap-10"],"children":["n0082"]},{"_id":"n0082","text":true,"v":"Core platform objects, no package to upgrade"},{"_id":"n0083","type":"Block","tag":"div","classes":["s_row-9"],"children":["n0084","n0086","n0087"]},{"_id":"n0084","type":"Block","tag":"div","classes":["s_wrap-9"],"children":["n0085"]},{"_id":"n0085","text":true,"v":"Household Accounts and Contacts"},{"_id":"n0086","type":"HtmlEmbed","tag":