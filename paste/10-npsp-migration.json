n":["n0114","n0116","n0117"]},{"_id":"n0114","type":"Block","tag":"div","classes":["s_wrap-9"],"children":["n0115"]},{"_id":"n0115","text":true,"v":"Engagement Plans"},{"_id":"n0116","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex-shrink: 0; margin-top: 2px;\"><path d=\"M5 12h14\"/><path d=\"M13 6l6 6-6 6\"/></svg>"}},"insideRTE":false}},{"_id":"n0117","type":"Block","tag":"div","classes":["s_wrap-10"],"children":["n0118"]},{"_id":"n0118","text":true,"v":"Action Plans"},{"_id":"n0119","type":"Block","tag":"div","classes":["s_row-23"],"children":["n0120","n0122","n0123"]},{"_id":"n0120","type":"Block","tag":"div","classes":["s_wrap-9"],"children":["n0121"]},{"_id":"n0121","text":true,"v":"Programme delivery in custom objects, usually"},{"_id":"n0122","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"flex-shrink: 0; margin-top: 2px;\"><path d=\"M5 12h14\"/><path d=\"M13 6l6 6-6 6\"/></svg>"}},"insideRTE":false}},{"_id":"n0123","type":"Block","tag":"div","classes":["s_wrap-10"],"children":["n0124"]},{"_id":"n0124","text":true,"v":"Program Management, Case Management and Outcome Management"},{"_id":"n0125","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0126","n0129"]},{"_id":"n0126","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0127"]},{"_id":"n0127","type":"Heading","tag":"h2","classes":["s_h-section-2"],"children":["n0128"],"data":{"tag":"h2"}},{"_id":"n0128","text":true,"v":"The assessment"},{"_id":"n0129","type":"Block","tag":"div","classes":["s_grid-3"],"children":["n0130","n0135","n0140"]},{"_id":"n0130","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0131","n0133"]},{"_id":"n0131","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0132"],"data":{"tag":"h3"}},{"_id":"n0132","text":true,"v":"Three weeks, fixed price"},{"_id":"n0133","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0134"]},{"_id":"n0134","text":true,"v":"Priced small and deliberately separate, so you can stop after it without having bought a migration."},{"_id":"n0135","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0136","n0138"]},{"_id":"n0136","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0137"],"data":{"tag":"h3"}},{"_id":"n0137","text":true,"v":"What we look at"},{"_id":"n0138","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0139"]},{"_id":"n0139","text":true,"v":"Your NPSP customisation, data volumes and quality, integrations, reporting, recurring giving setup, and what your team actually uses day to day."},{"_id":"n0140","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0141","n0143"]},{"_id":"n0141","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0142"],"data":{"tag":"h3"}},{"_id":"n0142","text":true,"v":"What you get"},{"_id":"n0143","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0144"]},{"_id":"n0144","text":true,"v":"A written recommendation with a real number: move, wait, or fix something else first. Plus a sequenced plan if the answer is move, and the findings to act on yourself if it is not."},{"_id":"n0145","type":"Section","tag":"section","classes":["s_section"],"children":["n0146","n0149"]},{"_id":"n0146","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0147"]},{"_id":"n0147","type":"Heading","tag":"h2","classes":["s_h-section-2"],"children":["n0148"],"data":{"tag":"h2"}},{"_id":"n0148","text":true,"v":"If the answer is move"},{"_id":"n0149","type":"Block","tag":"div","classes":["s_stack-4"],"children":["n0150","n0157","n0164"]},{"_id":"n0150","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0151","n0153","n0155"]},{"_id":"n0151","type":"Block","tag":"div","classes":["s_row"],"children":["n0152"]},{"_id":"n0152","text":true,"v":"01"},{"_id":"n0153","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0154"],"data":{"tag":"h3"}},{"_id":"n0154","text":true,"v":"Model first, migrate second"},{"_id":"n0155","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0156"]},{"_id":"n0156","text":true,"v":"Constituents, households, designations and recurring giving modelled in a sandbox and tested against your real data before anything is committed. The model is the migration."},{"_id":"n0157","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0158","n0160","n0162"]},{"_id":"n0158","type":"Block","tag":"div","classes":["s_row"],"children":["n0159"]},{"_id":"n0159","text":true,"v":"02"},{"_id":"n0160","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0161"],"data":{"tag":"h3"}},{"_id":"n0161","text":true,"v":"Run in parallel where it is possible"},{"_id":"n0162","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0163"]},{"_id":"n0163","text":true,"v":"Financial year boundaries, appeal cycles and audit periods decide the cutover, not the project plan. Where a parallel period is feasible we use it."},{"_id":"n0164","type":"Block","tag":"div","classes":["s_row-8"],"children":["n0165","n0167","n0169"]},{"_id":"n0165","type":"Block","tag":"div","classes":["s_row"],"children":["n0166"]},{"_id":"n0166","text":true,"v":"03"},{"_id":"n0167","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0168"],"data":{"tag":"h3"}},{"_id":"n0168","text":true,"v":"History, receipting and the audit trail"},{"_id":"n0169","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0170"]},{"_id":"n0170","text":true,"v":"Gift history, acknowledgements and the numbers your auditor and your funders rely on, reconciled before cutover rather than explained afterwards."},{"_id":"n0171","type":"Section","tag":"section","classes":["s_section-wash"],"children":["n0172","n0179"]},{"_id":"n0172","type":"Block","tag":"div","classes":["s_col-4"],"children":["n0173","n0175","n0177"]},{"_id":"n0173","type":"Heading","tag":"h2","classes":["s_h-cta"],"children":["n0174"],"data":{"tag":"h2"}},{"_id":"n0174","text":true,"v":"Start with the question, not the migration."},{"_id":"n0175","type":"Paragraph","tag":"p","classes":["s_body-md"],"children":["n0176"]},{"_id":"n0176","text":true,"v":"Tell us what is not working in NPSP today. Often the answer is a fix rather than a move, and that is a much cheaper conversation to have first."},{"_id":"n0177","type":"Paragraph","tag":"p","classes":["s_caption"],"children":["n0178"]},{"_id":"n0178","text":true,"v":"Blair Rooney, Managing Director. blair@enabledigital.co, +64 22 226 4252."},{"_id":"n0179","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0180"],"data":{"link":{"mode":"external","url":"#top"}}},{"_id":"n0180","text":true,"v":"Book the assessment"},{"_id":"n0181","type":"Block","tag":"footer","classes":["s_stack-3"],"children":["n0182","n0229"]},{"_id":"n0182","type":"Block","tag":"div","classes":["s_row-7"],"children":["n0183","n0192"]},{"_id":"n0183","type":"Block","tag":"div","classes":["s_col-3"],"children":["n0184","n0185","n0187"]},{"_id":"n0184","type":"Block","tag":"div","classes":["s_col"],"children":[]},{"_id":"n0185","type":"Paragraph","tag":"p","classes":["s_body-sm"],"children":["n0186"]},{"_id":"n0186","text":true,"v":"A Salesforce consultancy in Auckland and Wellington, working across every layer of the stack."},{"_id":"n0187","type":"Block","tag":"div","classes":["s_badge-slot"],"children":["n0188","n0190"]},{"_id":"n0188","type":"Block","tag":"div","classes":["s_wrap-4"],"children":["n0189"]},{"_id":"n0189","text":true,"v":"Salesforce Partner badge"},{"_id"