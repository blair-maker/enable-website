tag":"div","classes":["s_wrap-3"],"children":["n0043"]},{"_id":"n0043","text":true,"v":"Six systems, one person"},{"_id":"n0044","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg viewBox=\"0 0 480 268\" width=\"100%\" style=\"display: block; overflow: visible;\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\"><defs><marker id=\"ah\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0.8 L7.5 4 L0 7.2 Z\" fill=\"#C5D6E8\"/></marker></defs><text x=\"0\" y=\"10\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#5D7290\" text-anchor=\"start\">Six Systems</text><rect x=\"0\" y=\"24\" width=\"132\" height=\"30\" rx=\"9\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"39.0\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" font-weight=\"500\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Memberships</text><path d=\"M 136 39 C 172 39 176 135 200 135\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.3\" marker-end=\"url(#ah)\"/><rect x=\"0\" y=\"64\" width=\"132\" height=\"30\" rx=\"9\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"79.0\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" font-weight=\"500\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Donations</text><path d=\"M 136 79 C 172 79 176 135 200 135\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.3\" marker-end=\"url(#ah)\"/><rect x=\"0\" y=\"104\" width=\"132\" height=\"30\" rx=\"9\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"119.0\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" font-weight=\"500\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Events</text><path d=\"M 136 119 C 172 119 176 135 200 135\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.3\" marker-end=\"url(#ah)\"/><rect x=\"0\" y=\"144\" width=\"132\" height=\"30\" rx=\"9\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"159.0\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" font-weight=\"500\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Visits</text><path d=\"M 136 159 C 172 159 176 135 200 135\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.3\" marker-end=\"url(#ah)\"/><rect x=\"0\" y=\"184\" width=\"132\" height=\"30\" rx=\"9\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"199.0\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" font-weight=\"500\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Enquiries</text><path d=\"M 136 199 C 172 199 176 135 200 135\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.3\" marker-end=\"url(#ah)\"/><rect x=\"0\" y=\"224\" width=\"132\" height=\"30\" rx=\"9\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"239.0\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" font-weight=\"500\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Retail</text><path d=\"M 136 239 C 172 239 176 135 200 135\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.3\" marker-end=\"url(#ah)\"/><rect x=\"200\" y=\"96\" width=\"94\" height=\"78\" rx=\"14\" fill=\"#E8FCF2\"/><text x=\"247\" y=\"126\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#0A6B44\" text-anchor=\"middle\">Identity</text><text x=\"247\" y=\"142\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#0A6B44\" text-anchor=\"middle\">resolution</text><path d=\"M 294 135 L 330 135\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.8\" marker-end=\"url(#ah)\"/><rect x=\"338\" y=\"72\" width=\"142\" height=\"126\" rx=\"16\" fill=\"#F4F8FC\"/><text x=\"356\" y=\"98\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#0A6B44\" text-anchor=\"start\">One Profile</text><text x=\"356\" y=\"120\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Gave in 2019</text><text x=\"356\" y=\"142\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Member since 2021</text><text x=\"356\" y=\"164\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Visited 8 times</text><text x=\"356\" y=\"186\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Enquired last week</text></svg>"}},"insideRTE":false}},{"_id":"n0045","type":"Paragraph","tag":"p","classes":["s_caption-sm-2"],"children":["n0046"]},{"_id":"n0046","text":true,"v":"Resolution is where this kind of project succeeds or quietly fails. It is not a field-mapping exercise."},{"_id":"n0047","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0048"]},{"_id":"n0048","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0049","n0051"]},{"_id":"n0049","type":"Heading","tag":"h2","classes":["s_h-section-sm-3"],"children":["n0050"],"data":{"tag":"h2"}},{"_id":"n0050","text":true,"v":"The situation"},{"_id":"n0051","type":"Paragraph","tag":"p","classes":["s_body-lead"],"children":["n0052"]},{"_id":"n0052","text":true,"v":"Memberships in one place, donations in another, event attendance in a third, visits and enquiries elsewhere again. Nobody could answer a question as simple as \"what has this person actually done with us\" without opening several systems and making a judgement call about whether three similar records were the same human being. The organisation knew this. What it did not have was a way through it that did not begin with a multi-year data warehouse project."},{"_id":"n0053","type":"Section","tag":"section","classes":["s_section"],"children":["n0054","n0057"]},{"_id":"n0054","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0055"]},{"_id":"n0055","type":"Heading","tag":"h2","classes":["s_h-section-sm"],"children":["n0056"],"data":{"tag":"h2"}},{"_id":"n0056","text":true,"v":"What we built"},{"_id":"n0057","type":"Block","tag":"div","classes":["s_stack-4"],"children":["n0058","n0065","n0072","n0079"]},{"_id":"n0058","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0059","n0061","n0063"]},{"_id":"n0059","type":"Block","tag":"div","classes":["s_row"],"children":["n0060"]},{"_id":"n0060","text":true,"v":"01"},{"_id":"n0061","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0062"],"data":{"tag":"h3"}},{"_id":"n0062","text":true,"v":"Modelled to the Customer 360 data model"},{"_id":"n0063","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0064"]},{"_id":"n0064","text":true,"v":"Source systems mapped onto standard objects rather than a bespoke schema, so that what we built would still make sense to the next person and would not need re-mapping every time a source changed."},{"_id":"n0065","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0066","n0068","n0070"]},{"_id":"n0066","type":"Block","tag":"div","classes":["s_row"],"children":["n0067"]},{"_id":"n0067","text":true,"v":"02"},{"_id":"n0068","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0069"],"data":{"tag":"h3"}},{"_id":"n0069","text":true,"v":"Identity resolution that survives real data"},{"_id":"n0070","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0071"]},{"_id":"n0071","text":true,"v":"A ruleset tuned against the actual records, including the households, the shared email addresses and the people who have been in the database since the nineties under three spellings. Match rates were reviewed with staff who knew the constituents rather than signed off on a metric."},{"_id":"n0072","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0073","n0075","n0077"]},{"_id":"n0073","type":"Block","tag":"div","classes":["s_row"],"children":["n0074"]},{"_id":"n0074","text":true,"v":"03"},{"_id":"n0075","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0076"],"data":{"tag":"h3"}},{"_id":"n0076","text":true,"v":"Unified activity on the profile"},{"_id":"n0077","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0078"]},{"_id":"n0078","text":true,"v":"The engagement history brought together so that a single view shows what a person has done, in order, regardless of which system recorded it. This is the part users actually notice."},{"_id":"n0079","type":"Block","tag":"div","classes":["s_row-8"],"children":["n0080","n0082","n0084"]},{"_id":"n0080","type":"Block","tag":"div","classes":["s_row"],"children":["n0081"]},{"_id":"n0081","text":true,"v":"04"},{"_id":"n0082","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0083"],"data":{"tag":"h3"}},{"_id":"n0083","text":true,"v":"Deployed to production, with tests"},{"_id":"n0084","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0085"]},{"_id":"n0085","text":true,"v":"Apex covered per class, deployed with specified tests against a production org rather than left as a proof of concept somebody would productionise later."},{"_id":"n0086","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0087","n0090"]},{"_id":"n0087","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0088"]},{"_id":"n0088","type":"Heading","tag":"h2","classes":["s_h-section-sm"],"children":["n0089"],"data":{"tag":"h2"}},{"_id":"n0089","text":true,"v":"What changed"},{"_id":"n0090","type":"Block","tag":"div","classes":["s_grid-3"],"children":["n0091","n0096","n0101"]},{"_id":"n0091","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0092","n0094"]},{"_id":"n0092","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0093"],"data":{"tag":"h3"}},{"_id":"n0093","text":true,"v":"Staff stopped guessing"},{"_id":"n0094","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0095"]},{"_id":"n0095","text":true,"v":"The question \"have we talked to this person before\" is now answered on one screen instead of by three people checking three systems and comparing notes."},{"_id":"n0096","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0097","n0099"]},{"_id":"n0097","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0098"],"data":{"tag":"h3"}},{"_id":"n0098","text":true,"v":"A foundation, not an endpoint"},{"_id":"n0099","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0100"]},{"_id":"n0100","text":true,"v":"The unified profile is what segmentation, agent grounding and personalisation all need underneath them. Building it first made the next conversations shorter."},{"_id":"n0101","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0102","n0104"]},{"_id":"n0102","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0103"],"data":{"tag":"h3"}},{"_id":"n0103","text":true,"v":"Data quality became visible"},{"_id":"n0104","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0105"]},{"_id":"n0105","text":true,"v":"Resolution surfaces duplicates that everyone suspected and nobody could count. That is uncomfortable and useful in roughly equal measure."},{"_id":"n0106","type":"Section","tag":"section","classes":["s_stack-7"],"children":["n0107"]},{"_id":"n0107","type":"Block","tag":"div","classes":["s_card-tint-2"],"children":["n0108","n0110"]},{"_id":"n0108","type":"Heading","tag":"h2","classes":["s_h-card-lg-2"],"children":["n0109"],"data":{"tag":"h2"}},{"_id":"n0109","text":true,"v":"What we would tell you"},{"_id":"n0110","type":"Paragraph","tag":"p","classes":["s_body-md-3"],"children":["n0111"]},{"_id":"n0111","text":true,"v":"Identity resolution is where this kind of project succeeds or quietly fails, and it cannot be done well from a spreadsheet of field mappings. Budget for sitting with the people who know the constituents. Also: Data 360 consumption is real money, and we would rather model it with you before you commit than explain the bill afterwards."},{"_id":"n0112","type":"Section","tag":"section","classes":["s_section-wash"],"children":["n0113","n0120"]},{"_id":"n0113","type":"Block","tag":"div","classes":["s_col-4"],"children":["n0114","n0116","n0118"]},{"_id":"n0114","type":"Heading","tag":"h2","classes":["s_h-cta"],"children":["n0115"],"data":{"tag":"h2"}},{"_id":"n0115","text":true,"v":"Recognise any of this?"},{"_id":"n0116","type":"Paragraph","tag":"p","classes":["s_body-md"],"children":["n0117"]},{"_id":"n0117","text":true,"v":"If it sounds like your org, the first conversation is free and usually tells us both whether there is a project here."},{"_id":"n0118","type":"Paragraph","tag":"p","classes":["s_caption"],"children":["n0119"]},{"_id":"n0119","text":true,"v":"Client name withheld pending consent. Happy to make an introduction on request."},{"_id":"n0120","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0121"],"data":{"link":{"mode":"external","url":"#top"}}},{"_id":"n0121","text":true,"v":"Book a conversation"},{"_id":"n0122","type":"Block","tag":"footer","classes":["s_stack-3"],"children":["n0123","n0170"]},{"_id":"n0123","type":"Block","tag":"div","classes":["s_row-7"],"children":["n0124","n0133"]},{"_id":"n0124","type":"Block","tag":"div","classes":["s_col-3"],"children":["n0125","n0126","n0128"]},{"_id":"n0125","type":"Block","tag":"div","classes":["s_col"],"children":[]},{"_id":"n0126","type":"Paragraph","tag":"p","classes":["s_body-sm"],"children":["n0127"]},{"_id":"n0127","text":true,"v":"A Salesforce consultancy in Auckland and Wellington, working across every layer of the stack."},{"_id":"n0128","type":"Block","tag":"div","classes":["s_badge-slot"],"children":["n0129","n0131"]},{"_id":"n0129","type":"Block","tag":"div","classes":["s_wrap-4"],"children":["n0130"]},{"_id":"n0130","text":true,"v":"Salesforce Partner badge"},{"_id":"n0131","type":"Block","tag":"div","classes":["s_wrap-5"],"children":["n0132"]},{"_id":"n0132","text":true,"v":"168 \u00d7 97, ratio 1.74:1"},{"_id":"n0133","type":"Block","tag":"div","classes":["s_grid-4"],"children":["n0134","n0143","n0152","n0161"]},{"_id":"n0134","type":"Block","tag":"div","classes":["s_stack"],"children":["n0135","n0137","n0139","n0141"]},{"_id":"n0135","type":"Block","tag":"div","classes":["s_wrap-3"],"child