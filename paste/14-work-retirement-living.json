"s_wrap-3"],"children":["n0043"]},{"_id":"n0043","text":true,"v":"What the routing was doing"},{"_id":"n0044","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg viewBox=\"0 0 480 306\" width=\"100%\" style=\"display: block; overflow: visible;\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\"><defs><marker id=\"ah\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0.8 L7.5 4 L0 7.2 Z\" fill=\"#C5D6E8\"/></marker></defs><text x=\"0\" y=\"10\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#5D7290\" text-anchor=\"start\">Before</text><rect x=\"0\" y=\"26\" width=\"92\" height=\"20\" rx=\"6\" fill=\"#F4F8FC\"/><text x=\"46\" y=\"36\" font-family=\"Inter, sans-serif\" font-size=\"10\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Village 1</text><path d=\"M 96 36 C 180 36 200 65 268 65\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/><rect x=\"0\" y=\"52\" width=\"92\" height=\"20\" rx=\"6\" fill=\"#F4F8FC\"/><text x=\"46\" y=\"62\" font-family=\"Inter, sans-serif\" font-size=\"10\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Village 2</text><path d=\"M 96 62 C 180 62 200 65 268 65\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/><rect x=\"0\" y=\"78\" width=\"92\" height=\"20\" rx=\"6\" fill=\"#F4F8FC\"/><text x=\"46\" y=\"88\" font-family=\"Inter, sans-serif\" font-size=\"10\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Village 3</text><path d=\"M 96 88 C 180 88 200 65 268 65\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/><rect x=\"0\" y=\"104\" width=\"92\" height=\"20\" rx=\"6\" fill=\"#F4F8FC\"/><text x=\"46\" y=\"114\" font-family=\"Inter, sans-serif\" font-size=\"10\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Village 4</text><path d=\"M 96 114 C 180 114 200 65 268 65\" fill=\"none\" stroke=\"#DCE6F0\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/><rect x=\"276\" y=\"44\" width=\"204\" height=\"42\" rx=\"11\" fill=\"#F4F8FC\"/><rect x=\"276\" y=\"44\" width=\"4\" height=\"42\" rx=\"2\" fill=\"#5D7290\"/><text x=\"294\" y=\"65\" font-family=\"Inter, sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">One consultant</text><line x1=\"0\" y1=\"150\" x2=\"480\" y2=\"150\" stroke=\"#DCE6F0\" stroke-width=\"1\"/><text x=\"0\" y=\"178\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#0A6B44\" text-anchor=\"start\">After</text><rect x=\"0\" y=\"194\" width=\"92\" height=\"20\" rx=\"6\" fill=\"#F4F8FC\"/><text x=\"46\" y=\"204\" font-family=\"Inter, sans-serif\" font-size=\"10\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Village 1</text><path d=\"M 96 204 L 268 204\" fill=\"none\" stroke=\"#12795A\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/><rect x=\"276\" y=\"191\" width=\"204\" height=\"26\" rx=\"8\" fill=\"#F4F8FC\"/><rect x=\"276\" y=\"191\" width=\"4\" height=\"26\" rx=\"2\" fill=\"#12795A\"/><text x=\"294\" y=\"204\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Consultant 1</text><rect x=\"0\" y=\"220\" width=\"92\" height=\"20\" rx=\"6\" fill=\"#F4F8FC\"/><text x=\"46\" y=\"230\" font-family=\"Inter, sans-serif\" font-size=\"10\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Village 2</text><path d=\"M 96 230 L 268 230\" fill=\"none\" stroke=\"#17739A\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/><rect x=\"276\" y=\"217\" width=\"204\" height=\"26\" rx=\"8\" fill=\"#F4F8FC\"/><rect x=\"276\" y=\"217\" width=\"4\" height=\"26\" rx=\"2\" fill=\"#17739A\"/><text x=\"294\" y=\"230\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Consultant 2</text><rect x=\"0\" y=\"246\" width=\"92\" height=\"20\" rx=\"6\" fill=\"#F4F8FC\"/><text x=\"46\" y=\"256\" font-family=\"Inter, sans-serif\" font-size=\"10\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Village 3</text><path d=\"M 96 256 L 268 256\" fill=\"none\" stroke=\"#175C93\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/><rect x=\"276\" y=\"243\" width=\"204\" height=\"26\" rx=\"8\" fill=\"#F4F8FC\"/><rect x=\"276\" y=\"243\" width=\"4\" height=\"26\" rx=\"2\" fill=\"#175C93\"/><text x=\"294\" y=\"256\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Consultant 3</text><rect x=\"0\" y=\"272\" width=\"92\" height=\"20\" rx=\"6\" fill=\"#F4F8FC\"/><text x=\"46\" y=\"282\" font-family=\"Inter, sans-serif\" font-size=\"10\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Village 4</text><path d=\"M 96 282 L 268 282\" fill=\"none\" stroke=\"#7A5AF8\" stroke-width=\"1.4\" marker-end=\"url(#ah)\"/><rect x=\"276\" y=\"269\" width=\"204\" height=\"26\" rx=\"8\" fill=\"#F4F8FC\"/><rect x=\"276\" y=\"269\" width=\"4\" height=\"26\" rx=\"2\" fill=\"#7A5AF8\"/><text x=\"294\" y=\"282\" font-family=\"Inter, sans-serif\" font-size=\"11.5\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Consultant 4</text></svg>"}},"insideRTE":false}},{"_id":"n0045","type":"Paragraph","tag":"p","classes":["s_caption-sm-2"],"children":["n0046"]},{"_id":"n0046","text":true,"v":"The rules read correctly. A fallback written as a safety net had become the main path."},{"_id":"n0047","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0048"]},{"_id":"n0048","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0049","n0051"]},{"_id":"n0049","type":"Heading","tag":"h2","classes":["s_h-section-sm-3"],"children":["n0050"],"data":{"tag":"h2"}},{"_id":"n0050","text":true,"v":"The situation"},{"_id":"n0051","type":"Paragraph","tag":"p","classes":["s_body-lead"],"children":["n0052"]},{"_id":"n0052","text":true,"v":"Marketing was working. Enquiries were arriving. But follow-up was slow and uneven, and leadership could not see why. The routing rules looked correct on paper. What had happened was more ordinary: a fallback assignment, written as a safety net at go-live, had quietly become the main path, because several village-level users had been deactivated over the years and duplicates created in their place. Every enquiry that failed to match an active user fell through to the same queue and the same person."},{"_id":"n0053","type":"Section","tag":"section","classes":["s_section"],"children":["n0054","n0057"]},{"_id":"n0054","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0055"]},{"_id":"n0055","type":"Heading","tag":"h2","classes":["s_h-section-sm"],"children":["n0056"],"data":{"tag":"h2"}},{"_id":"n0056","text":true,"v":"What we built"},{"_id":"n0057","type":"Block","tag":"div","classes":["s_stack-4"],"children":["n0058","n0065","n0072","n0079"]},{"_id":"n0058","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0059","n0061","n0063"]},{"_id":"n0059","type":"Block","tag":"div","classes":["s_row"],"children":["n0060"]},{"_id":"n0060","text":true,"v":"01"},{"_id":"n0061","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0062"],"data":{"tag":"h3"}},{"_id":"n0062","text":true,"v":"Traced the routing, not the symptom"},{"_id":"n0063","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0064"]},{"_id":"n0064","text":true,"v":"The reported problem was slow follow-up. The actual problem was assignment. We followed real enquiries through the rules rather than reading the configuration and assuming it did what it said."},{"_id":"n0065","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0066","n0068","n0070"]},{"_id":"n0066","type":"Block","tag":"div","classes":["s_row"],"children":["n0067"]},{"_id":"n0067","text":true,"v":"02"},{"_id":"n0068","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0069"],"data":{"tag":"h3"}},{"_id":"n0069","text":true,"v":"Rebuilt assignment around the village"},{"_id":"n0070","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0071"]},{"_id":"n0071","text":true,"v":"Routing keyed to the village the person is enquiring about, with an owner per village and a fallback that alerts somebody rather than silently absorbing the work."},{"_id":"n0072","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0073","n0075","n0077"]},{"_id":"n0073","type":"Block","tag":"div","classes":["s_row"],"children":["n0074"]},{"_id":"n0074","text":true,"v":"03"},{"_id":"n0075","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0076"],"data":{"tag":"h3"}},{"_id":"n0076","text":true,"v":"Cleaned up the user estate"},{"_id":"n0077","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0078"]},{"_id":"n0078","text":true,"v":"Inactive users and their duplicates identified and resolved, which is unglamorous and was the actual root cause."},{"_id":"n0079","type":"Block","tag":"div","classes":["s_row-8"],"children":["n0080","n0082","n0084"]},{"_id":"n0080","type":"Block","tag":"div","classes":["s_row"],"children":["n0081"]},{"_id":"n0081","text":true,"v":"04"},{"_id":"n0082","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0083"],"data":{"tag":"h3"}},{"_id":"n0083","text":true,"v":"Made tours visible on the account"},{"_id":"n0084","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0085"]},{"_id":"n0085","text":true,"v":"Tour bookings were being recorded against a child object that the account page never showed, so a booked visit was invisible to anyone looking at the person. We surfaced it, and fixed a re-entrant save loop found along the way."},{"_id":"n0086","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0087","n0090"]},{"_id":"n0087","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0088"]},{"_id":"n0088","type":"Heading","tag":"h2","classes":["s_h-section-sm"],"children":["n0089"],"data":{"tag":"h2"}},{"_id":"n0089","text":true,"v":"What changed"},{"_id":"n0090","type":"Block","tag":"div","classes":["s_grid-3"],"children":["n0091","n0096","n0101"]},{"_id":"n0091","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0092","n0094"]},{"_id":"n0092","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0093"],"data":{"tag":"h3"}},{"_id":"n0093","text":true,"v":"Enquiries reach the right village"},{"_id":"n0094","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0095"]},{"_id":"n0095","text":true,"v":"Follow-up is now done by the person who knows the site the enquirer is asking about, which changes the quality of the conversation as much as the speed."},{"_id":"n0096","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0097","n0099"]},{"_id":"n0097","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0098"],"data":{"tag":"h3"}},{"_id":"n0098","text":true,"v":"One consultant got their week back"},{"_id":"n0099","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0100"]},{"_id":"n0100","text":true,"v":"The person absorbing the fallback was carrying work that was never meant to be theirs, and no report showed it."},{"_id":"n0101","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0102","n0104"]},{"_id":"n0102","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0103"],"data":{"tag":"h3"}},{"_id":"n0103","text":true,"v":"Leadership can see the funnel"},{"_id":"n0104","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0105"]},{"_id":"n0105","text":true,"v":"Enquiry through to tour through to outcome, per village, from records rather than from a manually maintained spreadsheet."},{"_id":"n0106","type":"Section","tag":"section","classes":["s_stack-7"],"children":["n0107"]},{"_id":"n0107","type":"Block","tag":"div","classes":["s_card-tint-2"],"children":["n0108","n0110"]},{"_id":"n0108","type":"Heading","tag":"h2","classes":["s_h-card-lg-2"],"children":["n0109"],"data":{"tag":"h2"}},{"_id":"n0109","text":true,"v":"What we would tell you"},{"_id":"n0110","type":"Paragraph","tag":"p","classes":["s_body-md-3"],"children":["n0111"]},{"_id":"n0111","text":true,"v":"Nobody had done anything wrong here. A sensible safety net at go-live became the default path over several years of ordinary staff turnover, and no report was looking at assignment. It is worth someone checking routing fallbacks annually, which is exactly the kind of thing a quarterly platform review catches."},{"_id":"n0112","type":"Section","tag":"section","classes":["s_section-wash"],"children":["n0113","n0120"]},{"_id":"n0113","type":"Block","tag":"div","classes":["s_col-4"],"children":["n0114","n0116","n0118"]},{"_id":"n0114","type":"Heading","tag":"h2","classes":["s_h-cta"],"children":["n0115"],"data":{"tag":"h2"}},{"_id":"n0115","text":true,"v":"Recognise any of this?"},{"_id":"n0116","type":"Paragraph","tag":"p","classes":["s_body-md"],"children":["n0117"]},{"_id":"n0117","text":true,"v":"If it sounds like your org, the first conversation is free and usually tells us both whether there is a project here."},{"_id":"n0118","type":"Paragraph","tag":"p","classes":["s_caption"],"children":["n0119"]},{"_id":"n0119","text":true,"v":"Client name withheld pending consent. Happy to make an introduction on request."},{"_id":"n0120","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0121"],"data":{"link":{"mode":"external","url":"#top"}}},{"_id":"n0121","text":true,"v":"Book a conversation"},{"_id":"n0122","type":"Block","tag":"footer","classes":["s_stack-3"],"children":["n0123","n0170"]},{"_id":"n0123","type":"Block","tag":"div","classes":["s_row-7"],"children":["n0124","n0133"]},{"_id":"n0124","type":"Block","tag":"div","classes":["s_col-3"],"children":["n0125","n0126","n0128"]},{"_id":"n0125","type":"Block","tag":"div","classes":["s_col"],"children":[]},{"_id":"n0126","type":"Paragraph","tag":"p","classes":["s_body-sm"],"children":["n0127"]},{"_id":"n0127","text":true,"v":"A Salesforce consultancy in Auckland and Wellington, working across every layer of the stack."},{"_id":"n0128","type":"Block","tag":"div","classes":["s_badge-slot"],"children":["n0129","n0131"]},{"_id":"n0129","type":"Block","tag":"div","classes":["s_wrap-4"],"children":["n0130"]},{"_id":"n0130","text":true,"v":"Salesforce Partner badge"},{"_id":"n0131","type":"Block","tag":"div","classes":["s_wrap-5"],"children":["n0132"]},{"_id":"n0132","text":true,"v":"168 \u00d7 97, ratio 1.74:1"},{"_id":"n0133","type":"Block","tag":"div","classes":["s_grid-4"],"children":["n0134","n0143","n0152","n0161"]},{"_id":"n0134","type":"Block","tag":"div","classes":["s_stack"],"children":["n0135","n0137","n0139","n0141"]},{"_id":"n0135","type":"Block","tag":"div","classes":["s_wrap-3"],"children":["n0136"]},{"_id":"n0136","text":true,"v":"Services"},{"_id":"n0137","type":"Link","tag":"a","classes":["s_wrap"],"children":["n0138"],"data":{"link":{"mode":"external","url":"/salesforce"}}},{"_id":"n0138","text":true,"v":"Salesforce practice"},{"_id":"n0139","type":"Link","tag":"a","classes":["s_wrap"],"children":["n0140"],"data":{"link":{"mode":"external","url":"/waypoint"}}},{"_id":"n0140","text":true,"v":"Waypoint"},{"_id":"n0141","type":"Link","tag":"a","classes":["s_wrap"],"children":["n0142"],"data":{"link":{"mode":"external","url":"/"}}},{"_id":"n0142","text":true,"v":"Training and enablement"},{"_id":"n0143","type":"Block","tag":"div","classes":["s_stack"],"children":["n0144","n0146","n0148","n0150"]},{"_id":"n0144","type":"Block","tag":"div","classes":["s_wrap-3"],"children":["n0145"]},{"_id":"n0145","text":true,"v":"Products"},{"_id":"n0146","type":"Link","tag":"a","classes":["s_wrap"],"children":["n0147"],"data":{"link":{"mode":"external","url":"/storeconnect"}}},{"_id":"n0147","text":true,"v":"StoreConnect"},{"_id":"n0148","type":"Link","tag":"a","classes":["s_wrap"],"c