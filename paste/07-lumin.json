on","classes":["s_section-wash-4"],"children":["n0023","n0033"]},{"_id":"n0023","type":"Block","tag":"div","classes":["s_col-12"],"children":["n0024","n0026","n0028"]},{"_id":"n0024","type":"Heading","tag":"h1","classes":["s_h-display"],"children":["n0025"],"data":{"tag":"h1"}},{"_id":"n0025","text":true,"v":"Agreements that never leave Salesforce."},{"_id":"n0026","type":"Paragraph","tag":"p","classes":["s_body-lg-3"],"children":["n0027"]},{"_id":"n0027","text":true,"v":"Enable implements Lumin Sign for Salesforce: agreements generated from your records, sent, signed and filed back against the right object, without anyone leaving the CRM or rekeying a name."},{"_id":"n0028","type":"Block","tag":"div","classes":["s_row-6"],"children":["n0029","n0031"]},{"_id":"n0029","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0030"],"data":{"link":{"mode":"external","url":"#cta"}}},{"_id":"n0030","text":true,"v":"Talk to us about Lumin"},{"_id":"n0031","type":"Link","tag":"a","classes":["s_btn-outline"],"children":["n0032"],"data":{"link":{"mode":"external","url":"#what"}}},{"_id":"n0032","text":true,"v":"See what it does"},{"_id":"n0033","type":"Block","tag":"div","classes":["s_card-float"],"children":["n0034","n0037","n0038"]},{"_id":"n0034","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0035"]},{"_id":"n0035","type":"Block","tag":"div","classes":["s_wrap-3"],"children":["n0036"]},{"_id":"n0036","text":true,"v":"Signing as a step, not a detour"},{"_id":"n0037","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg viewBox=\"0 0 480 262\" width=\"100%\" style=\"display: block; overflow: visible;\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\"><defs><marker id=\"ah\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0.8 L7.5 4 L0 7.2 Z\" fill=\"#C5D6E8\"/></marker></defs><rect x=\"0\" y=\"40\" width=\"480\" height=\"104\" rx=\"18\" fill=\"#F4F8FC\"/><text x=\"18\" y=\"64\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#0A6B44\" text-anchor=\"start\">Inside Salesforce</text><rect x=\"16\" y=\"82\" width=\"98\" height=\"44\" rx=\"12\" fill=\"#ffffff\"/><text x=\"65\" y=\"104\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" text-anchor=\"middle\" dominant-baseline=\"middle\">Generate</text><path d=\"M 116 104 L 128 104\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.8\" marker-end=\"url(#ah)\"/><rect x=\"132\" y=\"82\" width=\"98\" height=\"44\" rx=\"12\" fill=\"#ffffff\"/><text x=\"181\" y=\"104\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" text-anchor=\"middle\" dominant-baseline=\"middle\">Send</text><path d=\"M 232 104 L 244 104\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.8\" marker-end=\"url(#ah)\"/><rect x=\"248\" y=\"82\" width=\"98\" height=\"44\" rx=\"12\" fill=\"#ffffff\"/><text x=\"297\" y=\"104\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" text-anchor=\"middle\" dominant-baseline=\"middle\">Sign</text><path d=\"M 348 104 L 360 104\" fill=\"none\" stroke=\"#0A6B44\" stroke-width=\"1.8\" marker-end=\"url(#ah)\"/><rect x=\"364\" y=\"82\" width=\"98\" height=\"44\" rx=\"12\" fill=\"#ffffff\"/><text x=\"413\" y=\"104\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" text-anchor=\"middle\" dominant-baseline=\"middle\">File</text><text x=\"0\" y=\"196\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#5D7290\" text-anchor=\"start\">What It Replaces</text><rect x=\"0\" y=\"212\" width=\"88\" height=\"38\" rx=\"10\" fill=\"#ffffff\" stroke=\"#DCE6F0\"/><text x=\"44\" y=\"232\" font-family=\"Inter, sans-serif\" font-size=\"10.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Export to Word</text><rect x=\"97\" y=\"212\" width=\"88\" height=\"38\" rx=\"10\" fill=\"#ffffff\" stroke=\"#DCE6F0\"/><text x=\"141\" y=\"232\" font-family=\"Inter, sans-serif\" font-size=\"10.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Retype details</text><rect x=\"194\" y=\"212\" width=\"88\" height=\"38\" rx=\"10\" fill=\"#ffffff\" stroke=\"#DCE6F0\"/><text x=\"238\" y=\"232\" font-family=\"Inter, sans-serif\" font-size=\"10.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Upload to signer</text><rect x=\"291\" y=\"212\" width=\"88\" height=\"38\" rx=\"10\" fill=\"#ffffff\" stroke=\"#DCE6F0\"/><text x=\"335\" y=\"232\" font-family=\"Inter, sans-serif\" font-size=\"10.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Chase by email</text><rect x=\"388\" y=\"212\" width=\"88\" height=\"38\" rx=\"10\" fill=\"#ffffff\" stroke=\"#DCE6F0\"/><text x=\"432\" y=\"232\" font-family=\"Inter, sans-serif\" font-size=\"10.5\" fill=\"#5D7290\" text-anchor=\"middle\" dominant-baseline=\"middle\">Drag back in</text><line x1=\"0\" y1=\"231\" x2=\"473\" y2=\"231\" stroke=\"#5D7290\" stroke-width=\"1.5\"/></svg>"}},"insideRTE":false}},{"_id":"n0038","type":"Paragraph","tag":"p","classes":["s_caption-sm-2"],"children":["n0039"]},{"_id":"n0039","text":true,"v":"The top row never leaves the platform. The bottom row is the five steps it removes."},{"_id":"n0040","type":"Section","tag":"section","classes":["s_row-split-5"],"children":["n0041","n0043"]},{"_id":"n0041","type":"Block","tag":"div","classes":["s_caption-2"],"children":["n0042"]},{"_id":"n0042","text":true,"v":"Lumin is a New Zealand company, built in Christchurch since 2014"},{"_id":"n0043","type":"Block","tag":"div","classes":["s_row-14"],"children":["n0044","n0046","n0048","n0050"]},{"_id":"n0044","type":"Block","tag":"div","classes":["s_tag"],"children":["n0045"]},{"_id":"n0045","text":true,"v":"100 million users"},{"_id":"n0046","type":"Block","tag":"div","classes":["s_tag"],"children":["n0047"]},{"_id":"n0047","text":true,"v":"SOC 2"},{"_id":"n0048","type":"Block","tag":"div","classes":["s_tag"],"children":["n0049"]},{"_id":"n0049","text":true,"v":"Native Salesforce app"},{"_id":"n0050","type":"Block","tag":"div","classes":["s_tag"],"children":["n0051"]},{"_id":"n0051","text":true,"v":"AppExchange"},{"_id":"n0052","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0053","n0059"]},{"_id":"n0053","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0054","n0057"]},{"_id":"n0054","type":"Block","tag":"div","classes":["s_col-5"],"children":["n0055"]},{"_id":"n0055","type":"Heading","tag":"h2","classes":["s_h-section"],"children":["n0056"],"data":{"tag":"h2"}},{"_id":"n0056","text":true,"v":"The agreement is the one part of the deal that leaves the CRM."},{"_id":"n0057","type":"Paragraph","tag":"p","classes":["s_body-lead-2"],"children":["n0058"]},{"_id":"n0058","text":true,"v":"Everything up to the signature lives on the record. Then someone exports to Word, retypes the client details, uploads to a signing tool, chases it by email, downloads the signed copy and drags it back into Salesforce. Each of those steps is a place for the version to drift or the file to go missing."},{"_id":"n0059","type":"Block","tag":"div","classes":["s_grid-3-2"],"children":["n0060","n0065","n0070"]},{"_id":"n0060","type":"Block","tag":"div","classes":["s_card"],"children":["n0061","n0063"]},{"_id":"n0061","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0062"],"data":{"tag":"h3"}},{"_id":"n0062","text":true,"v":"Details retyped, and sometimes wrong"},{"_id":"n0063","type":"Paragraph","tag":"p","classes":["s_body-sm-2"],"children":["n0064"]},{"_id":"n0064","text":true,"v":"Names, entity details, amounts and dates already sit on the record. Retyping them into a template is both slow and the most common source of a document that has to be reissued."},{"_id":"n0065","type":"Block","tag":"div","classes":["s_card"],"children":["n0066","n0068"]},{"_id":"n0066","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0067"],"data":{"tag":"h3"}},{"_id":"n0067","text":true,"v":"Nobody can see where it is"},{"_id":"n0068","type":"Paragraph","tag":"p","classes":["s_body-sm-2"],"children":["n0069"]},{"_id":"n0069","text":true,"v":"Once a document is out for signature it disappears from the pipeline view. The status lives in someone's inbox, and the forecast quietly stops reflecting reality."},{"_id":"n0070","type":"Block","tag":"div","classes":["s_card"],"children":["n0071","n0073"]},{"_id":"n0071","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0072"],"data":{"tag":"h3"}},{"_id":"n0072","text":true,"v":"The signed copy ends up somewhere else"},{"_id":"n0073","type":"Paragraph","tag":"p","classes":["s_body-sm-2"],"children":["n0074"]},{"_id":"n0074","text":true,"v":"A shared drive, an inbox, occasionally a laptop. When the audit or the dispute arrives, finding the executed version becomes its own small project."},{"_id":"n0075","type":"Section","tag":"section","classes":["s_section"],"children":["n0076","n0079"]},{"_id":"n0076","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0077"]},{"_id":"n0077","type":"Heading","tag":"h2","classes":["s_h-section"],"children":["n0078"],"data":{"tag":"h2"}},{"_id":"n0078","text":true,"v":"Signing as a step in the process, not a detour out of it"},{"_id":"n0079","type":"Block","tag":"div","classes":["s_grid-2"],"children":["n0080","n0085","n0090","n0095"]},{"_id":"n0080","type":"Block","tag":"div","classes":["s_card-gradient-teal-2"],"children":["n0081","n0083"]},{"_id":"n0081","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0082"],"data":{"tag":"h3"}},{"_id":"n0082","text":true,"v":"Templates driven by your records"},{"_id":"n0083","type":"Paragraph","tag":"p","classes":["s_wrap-12"],"children":["n0084"]},{"_id":"n0084","text":true,"v":"Connect your Salesforce data to your contract templates once, and customer details flow into every document from then on. The document is generated from the record, so the record is always the source of truth."},{"_id":"n0085","type":"Block","tag":"div","classes":["s_card-gradient-cyan-2"],"children":["n0086","n0088"]},{"_id":"n0086","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0087"],"data":{"tag":"h3"}},{"_id":"n0087","text":true,"v":"Recipients sign without an account"},{"_id":"n0088","type":"Paragraph","tag":"p","classes":["s_wrap-13"],"children":["n0089"]},{"_id":"n0089","text":true,"v":"No sign-up, no password, no authentication maze between your customer and a completed agreement. The single largest cause of signing drop-off, removed."},{"_id":"n0090","type":"Block","tag":"div","classes":["s_card-gradient-blue-2"],"children":["n0091","n0093"]},{"_id":"n0091","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0092"],"data":{"tag":"h3"}},{"_id":"n0092","text":true,"v":"Status on the record, automation on top"},{"_id":"n0093","type":"Paragraph","tag":"p","classes":["s_wrap-16"],"children":["n0094"]},{"_id":"n0094","text":true,"v":"Sent, viewed, signed and declined are Salesforce data, which means Flow can act on them. Stage changes, task creation, onboarding kick-off and reminders all become things the platform does rather than things a person remembers."},{"_id":"n0095","type":"Block","tag":"div","classes":["s_card-gradient-navy"],"children":["n0096","n0098"]},{"_id":"n0096","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient-2"],"children":["n0097"],"data":{"tag":"h3"}},{"_id":"n0097","text":true,"v":"Encrypted, SOC 2, and filed correctly"},{"_id":"n0098","type":"Paragraph","tag":"p","classes":["s_wrap-17"],"children":["n0099"]},{"_id":"n0099","text":true,"v":"All transmission encrypted, SOC 2 compliance, full audit trail, and the executed copy filed against the right object automatically. When the audit arrives, the answer is a related list rather than a search."},{"_id":"n0100","type":"Section","tag":"section","classes":["s_section-wash-5"],"children":["n0101","n0106"]},{"_id":"n0101","type":"Block","tag":"div","classes":["s_col-10"],"children":["n0102","n0104"]},{"_id":"n0102","type":"Heading","tag":"h2","classes":["s_h-section-sm-5"],"children":["n0103"],"data":{"tag":"h2"}},{"_id":"n0103","text":true,"v":"The product is the easy part. The process around it is the work."},{"_id":"n0104","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0105"]},{"_id":"n0105","text":true,"v":"Installing a managed package takes an afternoon. Making signing a reliable step in how your business actually sells takes rather longer, and that is the part we do."},{"_id":"n0106","type":"Block","tag":"div","classes":["s_grid-2-2"],"children":["n0107","n0112","n0117","n0122"]},{"_id":"n0107","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0108","n0110"]},{"_id":"n0108","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0109"],"data":{"tag":"h3"}},{"_id":"n0109","text":true,"v":"Document and template design"},{"_id":"n0110","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0111"]},{"_id":"n0111","text":true,"v":"Your agreements rebuilt as templates that pull from the record, including the conditional clauses that change by product, region or entity type."},{"_id":"n0112","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0113","n0115"]},{"_id":"n0113","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0114"],"data":{"tag":"h3"}},{"_id":"n0114","text":true,"v":"Quote-to-signature process"},{"_id":"n0115","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0116"]},{"_id":"n0116","text":true,"v":"Where signing sits in the sales process, who approves what before it goes out, and what the platform does automatically once it comes back signed."},{"_id":"n0117","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0118","n0120"]},{"_id":"n0118","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0119"],"data":{"tag":"h3"}},{"_id":"n0119","text":true,"v":"Automation and notifications"},{"_id":"n0120","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0121"]},{"_id":"n0121","text":true,"v":"Flows that move the stage, raise onboarding tasks, chase the reminder and tell the right person, built on the signature status rather than on someone checking."},{"_id":"n0122","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0123","n0125"]},{"_id":"n0123","type":"Heading","tag":"h3","classes":["s_wrap-7"],"children":["n0124"],"data":{"tag":"h3"}},{"_id":"n0124","text":true,"v":"Records, retention and handover"},{"_id":"n0125","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0126"]},{"_id":"n0126","text":true,"v":"Where executed documents are filed, who can see them, how long they are kept, and the documentation your team needs to run it without us."},{"_id":"n0127","type":"Section","tag":"section","classes":["s_row-split-6"],"children":["n0128","n0135"]},{"_id":"n0128","type":"Block","tag":"div","classes":["s_col-4"],"children":["n0129","n0131","n0133"]},{"_id":"n0129","type":"Heading","tag":"h2","classes":["s_h-cta"],"children":["n0130"],"data":{"tag":"h2"}},{"_id":"n0130","text":true,"v":"Tell us what you send out for signature."},{"_id":"n0131","type":"Paragraph","tag":"p","classes":["s_body-md"],"children":["n0132"]},{"_id":"n0132","text":true,"v":"Quotes, contracts, consent forms, engagement letters or enrolments. If it starts life on a Salesforce record, it can finish there too."},{"_id":"n0133","type":"Paragraph","tag":"p","classes":["s_caption"],"children":["n0134"]},{"_id":"n0134","text":true,"v":"A New Zealand consultancy implementing a New Zealand product. Auckland and Wellington."},{"_id":"n0135","type":"Link","tag":"a","classes":["s_btn-primary-4"],"children":["n0136"],"data":{"link":{"mode":"external","url":"#top"}}},{"_id":"n013