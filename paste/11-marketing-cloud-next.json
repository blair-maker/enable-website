"s_section-wash-13"],"children":["n0023","n0033"]},{"_id":"n0023","type":"Block","tag":"div","classes":["s_col-6"],"children":["n0024","n0026","n0028"]},{"_id":"n0024","type":"Heading","tag":"h1","classes":["s_h-display"],"children":["n0025"],"data":{"tag":"h1"}},{"_id":"n0025","text":true,"v":"Marketing Cloud Next, from the first partner in APAC to deliver it."},{"_id":"n0026","type":"Paragraph","tag":"p","classes":["s_body-lg"],"children":["n0027"]},{"_id":"n0027","text":true,"v":"Campaigns on the core platform: audiences from Data 360, journeys built in Flow, and measurement that does not need a separate warehouse. We were first in the region to ship it and have been through seven implementations since."},{"_id":"n0028","type":"Block","tag":"div","classes":["s_row-6"],"children":["n0029","n0031"]},{"_id":"n0029","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0030"],"data":{"link":{"mode":"external","url":"/contact"}}},{"_id":"n0030","text":true,"v":"Talk to us"},{"_id":"n0031","type":"Link","tag":"a","classes":["s_btn-outline"],"children":["n0032"],"data":{"link":{"mode":"external","url":"#migration"}}},{"_id":"n0032","text":true,"v":"Migrating from SFMC or Pardot"},{"_id":"n0033","type":"Block","tag":"div","classes":["s_card-float"],"children":["n0034","n0037","n0038"]},{"_id":"n0034","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0035"]},{"_id":"n0035","type":"Block","tag":"div","classes":["s_wrap-3"],"children":["n0036"]},{"_id":"n0036","text":true,"v":"One journey, on the core platform"},{"_id":"n0037","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg viewBox=\"0 0 480 300\" width=\"100%\" style=\"display: block; overflow: visible;\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\"><defs><marker id=\"ah\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0.8 L7.5 4 L0 7.2 Z\" fill=\"#C5D6E8\"/></marker></defs><rect x=\"120\" y=\"0\" width=\"4\" height=\"46\" rx=\"2\" fill=\"#12795A\"/><rect x=\"124\" y=\"0\" width=\"236\" height=\"46\" rx=\"12\" fill=\"#F4F8FC\"/><rect x=\"124\" y=\"0\" width=\"8\" height=\"46\" fill=\"#F4F8FC\"/><text x=\"136\" y=\"18.0\" font-family=\"Inter, sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Segment from Data 360</text><text x=\"136\" y=\"35.0\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#5D7290\" dominant-baseline=\"middle\">2,840 people, refreshed hourly</text><path d=\"M 240 46 L 240 70\" fill=\"none\" stroke=\"#C5D6E8\" stroke-width=\"1.8\" marker-end=\"url(#ah)\"/><rect x=\"120\" y=\"70\" width=\"4\" height=\"46\" rx=\"2\" fill=\"#175C93\"/><rect x=\"124\" y=\"70\" width=\"236\" height=\"46\" rx=\"12\" fill=\"#F4F8FC\"/><rect x=\"124\" y=\"70\" width=\"8\" height=\"46\" fill=\"#F4F8FC\"/><text x=\"136\" y=\"88.0\" font-family=\"Inter, sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Email, we miss you</text><text x=\"136\" y=\"105.0\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#5D7290\" dominant-baseline=\"middle\">Sent, 38% open</text><path d=\"M 240 116 L 240 140\" fill=\"none\" stroke=\"#C5D6E8\" stroke-width=\"1.8\" marker-end=\"url(#ah)\"/><path d=\"M 240 140 L 316 178 L 240 216 L 164 178 Z\" fill=\"#F4F8FC\"/><text x=\"240\" y=\"178\" font-family=\"Inter, sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#0C2B4B\" text-anchor=\"middle\" dominant-baseline=\"middle\">Replied?</text><path d=\"M 164 178 L 116 178 L 116 226\" fill=\"none\" stroke=\"#C5D6E8\" stroke-width=\"1.8\" marker-end=\"url(#ah)\"/><path d=\"M 316 178 L 364 178 L 364 226\" fill=\"none\" stroke=\"#C5D6E8\" stroke-width=\"1.8\" marker-end=\"url(#ah)\"/><text x=\"96\" y=\"170\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#0A6B44\" text-anchor=\"start\">Yes</text><text x=\"332\" y=\"170\" font-family=\"Inter, sans-serif\" font-size=\"11\" font-weight=\"600\" fill=\"#5D7290\" text-anchor=\"start\">No</text><rect x=\"0\" y=\"226\" width=\"4\" height=\"62\" rx=\"2\" fill=\"#7A5AF8\"/><rect x=\"4\" y=\"226\" width=\"228\" height=\"62\" rx=\"12\" fill=\"#F4F8FC\"/><rect x=\"4\" y=\"226\" width=\"8\" height=\"62\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"252.0\" font-family=\"Inter, sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Agentforce takes the reply</text><text x=\"16\" y=\"269.0\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#5D7290\" dominant-baseline=\"middle\">Grounded in the same records</text><rect x=\"248\" y=\"226\" width=\"4\" height=\"62\" rx=\"2\" fill=\"#17739A\"/><rect x=\"252\" y=\"226\" width=\"228\" height=\"62\" rx=\"12\" fill=\"#F4F8FC\"/><rect x=\"252\" y=\"226\" width=\"8\" height=\"62\" fill=\"#F4F8FC\"/><text x=\"264\" y=\"252.0\" font-family=\"Inter, sans-serif\" font-size=\"13\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">SMS nudge</text><text x=\"264\" y=\"269.0\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#5D7290\" dominant-baseline=\"middle\">1,190 people</text></svg>"}},"insideRTE":false}},{"_id":"n0038","type":"Paragraph","tag":"p","classes":["s_caption-sm-2"],"children":["n0039"]},{"_id":"n0039","text":true,"v":"Audience, journey, send, branch and reply all in one org. The report does not begin with an export."},{"_id":"n0040","type":"Section","tag":"section","classes":["s_row-split-4"],"children":["n0041","n0043"]},{"_id":"n0041","type":"Block","tag":"div","classes":["s_wrap-11"],"children":["n0042"]},{"_id":"n0042","text":true,"v":"Our position on this product"},{"_id":"n0043","type":"Block","tag":"div","classes":["s_row-wrap-2"],"children":["n0044","n0046","n0048"]},{"_id":"n0044","type":"Block","tag":"div","classes":["s_tag"],"children":["n0045"]},{"_id":"n0045","text":true,"v":"First in APAC to deliver it"},{"_id":"n0046","type":"Block","tag":"div","classes":["s_tag"],"children":["n0047"]},{"_id":"n0047","text":true,"v":"Seven implementations since"},{"_id":"n0048","type":"Block","tag":"div","classes":["s_tag"],"children":["n0049"]},{"_id":"n0049","text":true,"v":"In the product since launch"},{"_id":"n0050","type":"Section","tag":"section","classes":["s_section"],"children":["n0051","n0056"]},{"_id":"n0051","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0052","n0054"]},{"_id":"n0052","type":"Heading","tag":"h2","classes":["s_h-section-3"],"children":["n0053"],"data":{"tag":"h2"}},{"_id":"n0053","text":true,"v":"What it is, as a product"},{"_id":"n0054","type":"Paragraph","tag":"p","classes":["s_body-lead"],"children":["n0055"]},{"_id":"n0055","text":true,"v":"Marketing Cloud Next is not the old Marketing Cloud with a new badge. It runs on the core platform, which changes what a campaign can see and what it can trigger."},{"_id":"n0056","type":"Block","tag":"div","classes":["s_grid-2"],"children":["n0057","n0063","n0069","n0075"]},{"_id":"n0057","type":"Block","tag":"div","classes":["s_card-gradient-teal"],"children":["n0058","n0061"]},{"_id":"n0058","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0059"]},{"_id":"n0059","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0060"],"data":{"tag":"h3"}},{"_id":"n0060","text":true,"v":"Journeys built in Flow"},{"_id":"n0061","type":"Paragraph","tag":"p","classes":["s_wrap-12"],"children":["n0062"]},{"_id":"n0062","text":true,"v":"The same Flow your admins already know, not a separate journey canvas with its own logic and its own outages. A journey can call anything the platform can do."},{"_id":"n0063","type":"Block","tag":"div","classes":["s_card-gradient-cyan"],"children":["n0064","n0067"]},{"_id":"n0064","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0065"]},{"_id":"n0065","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0066"],"data":{"tag":"h3"}},{"_id":"n0066","text":true,"v":"Content and channels"},{"_id":"n0067","type":"Paragraph","tag":"p","classes":["s_wrap-13"],"children":["n0068"]},{"_id":"n0068","text":true,"v":"Branded email and content on the platform, plus SMS, WhatsApp and push. Sender setup, templates and reusable content blocks that marketers maintain themselves."},{"_id":"n0069","type":"Block","tag":"div","classes":["s_card-gradient-blue"],"children":["n0070","n0073"]},{"_id":"n0070","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0071"]},{"_id":"n0071","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0072"],"data":{"tag":"h3"}},{"_id":"n0072","text":true,"v":"Segments from Data 360"},{"_id":"n0073","type":"Paragraph","tag":"p","classes":["s_wrap-16"],"children":["n0074"]},{"_id":"n0074","text":true,"v":"Audiences built on the unified profile rather than on a list someone exported. Membership updates as the data does, so a segment is a rule, not a snapshot."},{"_id":"n0075","type":"Block","tag":"div","classes":["s_card-gradient-navy-2"],"children":["n0076","n0079"]},{"_id":"n0076","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0077"]},{"_id":"n0077","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0078"],"data":{"tag":"h3"}},{"_id":"n0078","text":true,"v":"Agentforce inside the campaign"},{"_id":"n0079","type":"Paragraph","tag":"p","classes":["s_wrap-17"],"children":["n0080"]},{"_id":"n0080","text":true,"v":"Agents that answer the reply, qualify the response and pick up the conversation the campaign started, grounded in the same records."},{"_id":"n0081","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0082","n0085"]},{"_id":"n0082","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0083"]},{"_id":"n0083","type":"Heading","tag":"h2","classes":["s_h-section-2"],"children":["n0084"],"data":{"tag":"h2"}},{"_id":"n0084","text":true,"v":"The three things that decide whether it works"},{"_id":"n0085","type":"Block","tag":"div","classes":["s_grid-3"],"children":["n0086","n0091","n0096"]},{"_id":"n0086","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0087","n0089"]},{"_id":"n0087","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0088"],"data":{"tag":"h3"}},{"_id":"n0088","text":true,"v":"Data 360, the audience layer"},{"_id":"n0089","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0090"]},{"_id":"n0090","text":true,"v":"Identity resolution, unified profiles and calculated insights. A segment is only ever as good as the resolution underneath it, and most campaigns that misfire, misfire here rather than in the creative. We model the credits before you commit, because consumption is where these programmes get expensive."},{"_id":"n0091","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0092","n0094"]},{"_id":"n0092","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0093"],"data":{"tag":"h3"}},{"_id":"n0093","text":true,"v":"Personalisation, the moment"},{"_id":"n0094","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0095"]},{"_id":"n0095","text":true,"v":"Real time means acting on behaviour as it happens: a browse, an abandoned form, a change in the profile. Not a list assembled three weeks after the moment has passed. This is the difference between personalisation and a mail merge, and it is the reason the platform sits where it does."},{"_id":"n0096","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0097","n0099"]},{"_id":"n0097","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0098"],"data":{"tag":"h3"}},{"_id":"n0098","text":true,"v":"Intelligence, the measurement"},{"_id":"n0099","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0100"]},{"_id":"n0100","text":true,"v":"Engagement scoring, Einstein assists and attribution that runs back to pipeline or to giving in the same org. Because it is one platform, the report does not begin with an export, which is usually where marketing measurement quietly stops being trusted."},{"_id":"n0101","type":"Section","tag":"section","classes":["s_section"],"children":["n0102","n0107"]},{"_id":"n0102","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0103","n0105"]},{"_id":"n0103","type":"Heading","tag":"h2","classes":["s_h-section-3"],"children":["n0104"],"data":{"tag":"h2"}},{"_id":"n0104","text":true,"v":"Migrating from Marketing Cloud Engagement or Pardot"},{"_id":"n0105","type":"Paragraph","tag":"p","classes":["s_body-lead"],"children":["n0106"]},{"_id":"n0106","text":true,"v":"Most estates we look at carry a decade of journeys, half of which nobody has switched off. The migration is an opportunity to stop running those, and the plan should say so out loud."},{"_id":"n0107","type":"Block","tag":"div","classes":["s_stack-4"],"children":["n0108","n0115","n0122","n0129"]},{"_id":"n0108","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0109","n0111","n0113"]},{"_id":"n0109","type":"Block","tag":"div","classes":["s_row"],"children":["n0110"]},{"_id":"n0110","text":true,"v":"01"},{"_id":"n0111","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0112"],"data":{"tag":"h3"}},{"_id":"n0112","text":true,"v":"Decide what actually moves"},{"_id":"n0113","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0114"]},{"_id":"n0114","text":true,"v":"An inventory of every journey, automation and send, with an owner and a last-run date against each. A surprising amount of it gets retired rather than rebuilt, and that is the cheapest win available."},{"_id":"n0115","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0116","n0118","n0120"]},{"_id":"n0116","type":"Block","tag":"div","classes":["s_row"],"children":["n0117"]},{"_id":"n0117","text":true,"v":"02"},{"_id":"n0118","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0119"],"data":{"tag":"h3"}},{"_id":"n0119","text":true,"v":"Data and consent before anything else"},{"_id":"n0120","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0121"]},{"_id":"n0121","text":true,"v":"Subscriber data, preference centres, consent records and suppression lists reconciled first. Getting consent wrong in a migration is the one mistake with a regulator attached to it."},{"_id":"n0122","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0123","n0125","n0127"]},{"_id":"n0123","type":"Block","tag":"div","classes":["s_row"],"children":["n0124"]},{"_id":"n0124","text":true,"v":"03"},{"_id":"n0125","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0126"],"data":{"tag":"h3"}},{"_id":"n0126","text":true,"v":"Deliverability and authentication"},{"_id":"n0127","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0128"]},{"_id":"n0128","text":true,"v":"SPF, DKIM, DMARC, sending domains and IP warm-up planned before the first production send. Sending reputation takes months to build and one bad weekend to lose."},{"_id":"n0129","type":"Block","tag":"div","classes":["s_row-8"],"children":["n0130","n0132","n0134"]},{"_id":"n0130","type":"Block","tag":"div","classes":["s_row"],"children":["n0131"]},{"_id":"n0131","text":true,"v":"04"},{"_id":"n0132","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0133"],"data":{"tag":"h3"}},{"_id":"n0133","text":true,"v":"Parallel run, then switch"},{"_id":"n0134","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0135"]},{"_id":"n0135","text":true,"v":"Both platforms live, results compared on real sends, then cut over. We do not do big-bang marketing migrations, and we will not lift a broken journey across so it can keep being broken."},{"_id":"n0136","type":"Section","tag":"section","classes":["s_section-wash"],"children":["n0137","n0144"]},{"_id":"n0137","type":"Block","tag":"div","classes":["s_col-4"],"children":["n0138","n0140","n0142"]},{"_id":"n0138","type":"Heading","tag":"h2","classes":["s_h-cta"],"children":["n0139"],"data":{"tag":"h2"}},{"_id":"n0139","text":true,"v":"What are you sending today, and what is it doing?"},{"_id":"n0140","type":"Paragraph","tag":"p","classes":["s_body-md"],"children":["n0141"]},{"_id":"n0141","text":true,"v":"Bring the journey inventory if you have one. If you do not, that is usually the first thing worth building, and it is often where the business case comes from."},{"_id":"n0142","type":"Paragraph","tag":"p","classes":["s_caption"],"children":["n0143"]},{"_id":"n0143","text":true,"v":"Blair Rooney, Managing Director. blair@enabledigital.co, +64 22 226 4252."},{"_id":"n0144","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0145"],"data":{"link":{"mode":"external","url":"#top"}}},{"_id":"n0145","text":true,"v":"Book a conversation"},{"_id":"n0146","type":"Block","tag":"footer","classes":["s_stack-3"],"children":["n0147","n0194"]},{"_id":"n0147","type":"Block","tag":"div","classes":["s_row-7"],"children":["n0148","n0157"]},{"_id":"n0148","type":"Block","tag":"div","classes":["s_col-3"],"children":["n0149","n0150","n0152"]},{"_id":"n0149","type":"Block","tag":"div","classes":["s_col"],"children":[]},{"_id":"n0150","type":"Paragraph","tag":"p","classes":["s_body-sm"],"children":["n0151"]},{"_id":"n0151","text":true,"v":"A Salesforce consultancy in Auckland and Wellington, working across every layer of the stack."},{"_id":"n0152","type":"Block","tag":"div","classes":["s_badge-slot"],"children":["n0153","n0155"]},{"_id":"n0153","type":"Block","tag":"div","classes":["s_wrap-4"],"children":["n0154"]},{"_id":"n0154","text":true,"v":"Salesforce Partner badge"},{"_id":"n0155","type":"Block","tag":"div","classes":["s_wrap-5"],"children":["n0156"]},{"_id":"n0156","text":true,"v":"168 \u00d7 97, ratio 1.74:1"},{"_id":"n0157","type":"Block","tag":"div","classes":["s_grid-4"],"children":["n0158","n0167","n0176","n0185"]},{"_id":"n0158","type":"Block","tag":"div","classes":["