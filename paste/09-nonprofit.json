{"type":"@webflow/XscpData","payload":{"nodes":[{"_id":"n0002","type":"Block","tag":"header","classes":["s_navbar"],"children":["n0003","n0005"]},{"_id":"n0003","type":"Link","tag":"a","classes":["s_row-4"],"children":["n0004"],"data":{"link":{"mode":"external","url":"/"}}},{"_id":"n0004","type":"Block","tag":"div","classes":["s_col"],"children":[]},{"_id":"n0005","type":"Block","tag":"nav","classes":["s_row-5"],"children":["n0006","n0008","n0010","n0012","n0014","n0016","n0018","n0020"]},{"_id":"n0006","type":"Link","tag":"a","classes":["s_wrap-2"],"children":["n0007"],"data":{"link":{"mode":"external","url":"/"}}},{"_id":"n0007","text":true,"v":"The stack"},{"_id":"n0008","type":"Link","tag":"a","classes":["s_wrap-2"],"children":["n0009"],"data":{"link":{"mode":"external","url":"/salesforce"}}},{"_id":"n0009","text":true,"v":"Salesforce"},{"_id":"n0010","type":"Link","tag":"a","classes":["s_wrap-2"],"children":["n0011"],"data":{"link":{"mode":"external","url":"/lumin"}}},{"_id":"n0011","text":true,"v":"Products"},{"_id":"n0012","type":"Link","tag":"a","classes":["s_wrap-2"],"children":["n0013"],"data":{"link":{"mode":"external","url":"/waypoint"}}},{"_id":"n0013","text":true,"v":"Waypoint"},{"_id":"n0014","type":"Link","tag":"a","classes":["s_wrap-6"],"children":["n0015"],"data":{"link":{"mode":"external","url":"#top"}}},{"_id":"n0015","text":true,"v":"Nonprofit"},{"_id":"n0016","type":"Link","tag":"a","classes":["s_wrap-2"],"children":["n0017"],"data":{"link":{"mode":"external","url":"/marketingcloudnext"}}},{"_id":"n0017","text":true,"v":"Marketing"},{"_id":"n0018","type":"Link","tag":"a","classes":["s_wrap-2"],"children":["n0019"],"data":{"link":{"mode":"external","url":"/casestudies"}}},{"_id":"n0019","text":true,"v":"Work"},{"_id":"n0020","type":"Link","tag":"a","classes":["s_btn-primary-2"],"children":["n0021"],"data":{"link":{"mode":"external","url":"/contact"}}},{"_id":"n0021","text":true,"v":"Contact us"},{"_id":"n0022","type":"Section","tag":"section","classes":["s_section-wash-4"],"children":["n0023","n0033"]},{"_id":"n0023","type":"Block","tag":"div","classes":["s_col-8"],"children":["n0024","n0026","n0028"]},{"_id":"n0024","type":"Heading","tag":"h1","classes":["s_h-display"],"children":["n0025"],"data":{"tag":"h1"}},{"_id":"n0025","text":true,"v":"Fundraising, programmes and the people behind both, on one platform."},{"_id":"n0026","type":"Paragraph","tag":"p","classes":["s_body-lg"],"children":["n0027"]},{"_id":"n0027","text":true,"v":"Agentforce Nonprofit, still widely called Nonprofit Cloud, puts giving, programme delivery, case management and outcomes on core Salesforce objects. Enable builds it around how your organisation actually works."},{"_id":"n0028","type":"Block","tag":"div","classes":["s_row-6"],"children":["n0029","n0031"]},{"_id":"n0029","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0030"],"data":{"link":{"mode":"external","url":"/contact"}}},{"_id":"n0030","text":true,"v":"Talk to us"},{"_id":"n0031","type":"Link","tag":"a","classes":["s_btn-outline"],"children":["n0032"],"data":{"link":{"mode":"external","url":"/npspmigration"}}},{"_id":"n0032","text":true,"v":"Moving off NPSP?"},{"_id":"n0033","type":"Block","tag":"div","classes":["s_card-float"],"children":["n0034","n0037","n0038"]},{"_id":"n0034","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0035"]},{"_id":"n0035","type":"Block","tag":"div","classes":["s_wrap-3"],"children":["n0036"]},{"_id":"n0036","text":true,"v":"One supporter, four relationships"},{"_id":"n0037","type":"HtmlEmbed","tag":"div","classes":[],"children":[],"data":{"embed":{"type":"html","meta":{"html":"<svg viewBox=\"0 0 480 284\" width=\"100%\" style=\"display: block; overflow: visible;\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\"><defs><marker id=\"ah\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0.8 L7.5 4 L0 7.2 Z\" fill=\"#C5D6E8\"/></marker></defs><path d=\"M 184 141 L 92 42\" fill=\"none\" stroke=\"#C5D6E8\" stroke-width=\"1.6\"/><path d=\"M 240 141 L 388 42\" fill=\"none\" stroke=\"#C5D6E8\" stroke-width=\"1.6\"/><path d=\"M 184 141 L 92 242\" fill=\"none\" stroke=\"#C5D6E8\" stroke-width=\"1.6\"/><path d=\"M 240 141 L 388 242\" fill=\"none\" stroke=\"#C5D6E8\" stroke-width=\"1.6\"/><circle cx=\"240\" cy=\"141\" r=\"58\" fill=\"#F4F8FC\"/><circle cx=\"240\" cy=\"141\" r=\"58\" fill=\"none\" stroke=\"#1EE885\" stroke-width=\"3\"/><text x=\"240\" y=\"134\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" text-anchor=\"middle\">One</text><text x=\"240\" y=\"153\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" text-anchor=\"middle\">person</text><rect x=\"0\" y=\"8\" width=\"4\" height=\"68\" rx=\"2\" fill=\"#12795A\"/><rect x=\"4\" y=\"8\" width=\"180\" height=\"68\" rx=\"12\" fill=\"#F4F8FC\"/><rect x=\"4\" y=\"8\" width=\"8\" height=\"68\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"37.0\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Regular giver</text><text x=\"16\" y=\"54.0\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#5D7290\" dominant-baseline=\"middle\">$40 monthly</text><rect x=\"296\" y=\"8\" width=\"4\" height=\"68\" rx=\"2\" fill=\"#17739A\"/><rect x=\"300\" y=\"8\" width=\"180\" height=\"68\" rx=\"12\" fill=\"#F4F8FC\"/><rect x=\"300\" y=\"8\" width=\"8\" height=\"68\" fill=\"#F4F8FC\"/><text x=\"312\" y=\"37.0\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Volunteer</text><text x=\"312\" y=\"54.0\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#5D7290\" dominant-baseline=\"middle\">212 hours</text><rect x=\"0\" y=\"208\" width=\"4\" height=\"68\" rx=\"2\" fill=\"#175C93\"/><rect x=\"4\" y=\"208\" width=\"180\" height=\"68\" rx=\"12\" fill=\"#F4F8FC\"/><rect x=\"4\" y=\"208\" width=\"8\" height=\"68\" fill=\"#F4F8FC\"/><text x=\"16\" y=\"237.0\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Service user</text><text x=\"16\" y=\"254.0\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#5D7290\" dominant-baseline=\"middle\">Restricted view</text><rect x=\"296\" y=\"208\" width=\"4\" height=\"68\" rx=\"2\" fill=\"#7A5AF8\"/><rect x=\"300\" y=\"208\" width=\"180\" height=\"68\" rx=\"12\" fill=\"#F4F8FC\"/><rect x=\"300\" y=\"208\" width=\"8\" height=\"68\" fill=\"#F4F8FC\"/><text x=\"312\" y=\"237.0\" font-family=\"Inter, sans-serif\" font-size=\"14\" font-weight=\"600\" fill=\"#0C2B4B\" dominant-baseline=\"middle\">Household</text><text x=\"312\" y=\"254.0\" font-family=\"Inter, sans-serif\" font-size=\"11\" fill=\"#5D7290\" dominant-baseline=\"middle\">Three people</text></svg>"}},"insideRTE":false}},{"_id":"n0038","type":"Paragraph","tag":"p","classes":["s_caption-sm-2"],"children":["n0039"]},{"_id":"n0039","text":true,"v":"A data model built for B2B sales handles this badly, and the damage shows up in the stewardship."},{"_id":"n0040","type":"Section","tag":"section","classes":["s_section"],"children":["n0041","n0046"]},{"_id":"n0041","type":"Block","tag":"div","classes":["s_row-3"],"children":["n0042","n0044"]},{"_id":"n0042","type":"Heading","tag":"h2","classes":["s_h-section-3"],"children":["n0043"],"data":{"tag":"h2"}},{"_id":"n0043","text":true,"v":"What Nonprofit Cloud actually covers"},{"_id":"n0044","type":"Paragraph","tag":"p","classes":["s_body-lead"],"children":["n0045"]},{"_id":"n0045","text":true,"v":"It is broader than fundraising, and that breadth is the point. Most nonprofits run a CRM for donors and something else entirely for the work the donations pay for. Nonprofit Cloud is the first credible Salesforce answer to having both in one place."},{"_id":"n0046","type":"Block","tag":"div","classes":["s_grid-3-2"],"children":["n0047","n0053","n0059","n0065","n0071","n0077"]},{"_id":"n0047","type":"Block","tag":"div","classes":["s_card-gradient-teal"],"children":["n0048","n0051"]},{"_id":"n0048","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0049"]},{"_id":"n0049","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0050"],"data":{"tag":"h3"}},{"_id":"n0050","text":true,"v":"Fundraising"},{"_id":"n0051","type":"Paragraph","tag":"p","classes":["s_wrap-12"],"children":["n0052"]},{"_id":"n0052","text":true,"v":"Gift transactions, gift commitments for recurring giving, designations and soft credits, with donor rollups that do not need a nightly job to be trusted."},{"_id":"n0053","type":"Block","tag":"div","classes":["s_card-gradient-cyan"],"children":["n0054","n0057"]},{"_id":"n0054","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0055"]},{"_id":"n0055","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0056"],"data":{"tag":"h3"}},{"_id":"n0056","text":true,"v":"Programme management"},{"_id":"n0057","type":"Paragraph","tag":"p","classes":["s_wrap-13"],"children":["n0058"]},{"_id":"n0058","text":true,"v":"Programmes, cohorts, enrolments and service delivery, so the work the organisation actually does is a record rather than a spreadsheet beside the CRM."},{"_id":"n0059","type":"Block","tag":"div","classes":["s_card-gradient-blue"],"children":["n0060","n0063"]},{"_id":"n0060","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0061"]},{"_id":"n0061","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0062"],"data":{"tag":"h3"}},{"_id":"n0062","text":true,"v":"Case management"},{"_id":"n0063","type":"Paragraph","tag":"p","classes":["s_wrap-16"],"children":["n0064"]},{"_id":"n0064","text":true,"v":"Client intake, assessment, referral and review for social services, with the confidentiality and sharing model that kind of data demands."},{"_id":"n0065","type":"Block","tag":"div","classes":["s_card-gradient-navy-2"],"children":["n0066","n0069"]},{"_id":"n0066","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0067"]},{"_id":"n0067","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0068"],"data":{"tag":"h3"}},{"_id":"n0068","text":true,"v":"Outcome measurement"},{"_id":"n0069","type":"Paragraph","tag":"p","classes":["s_wrap-17"],"children":["n0070"]},{"_id":"n0070","text":true,"v":"Indicators, baselines and results tracked against programmes, so the impact report is generated from the data rather than reconstructed each year."},{"_id":"n0071","type":"Block","tag":"div","classes":["s_card-gradient-teal"],"children":["n0072","n0075"]},{"_id":"n0072","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0073"]},{"_id":"n0073","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0074"],"data":{"tag":"h3"}},{"_id":"n0074","text":true,"v":"Grantmaking"},{"_id":"n0075","type":"Paragraph","tag":"p","classes":["s_wrap-12"],"children":["n0076"]},{"_id":"n0076","text":true,"v":"For funders: applications, review, award, disbursement and reporting, on the same platform as the relationships behind them."},{"_id":"n0077","type":"Block","tag":"div","classes":["s_card-gradient-cyan"],"children":["n0078","n0081"]},{"_id":"n0078","type":"Block","tag":"div","classes":["s_row-split"],"children":["n0079"]},{"_id":"n0079","type":"Heading","tag":"h3","classes":["s_h-card-on-gradient"],"children":["n0080"],"data":{"tag":"h3"}},{"_id":"n0080","text":true,"v":"Volunteers and supporters"},{"_id":"n0081","type":"Paragraph","tag":"p","classes":["s_wrap-13"],"children":["n0082"]},{"_id":"n0082","text":true,"v":"Volunteer roles, shifts and hours alongside the household and constituent model, so a person who gives time and money is one record, not two."},{"_id":"n0083","type":"Section","tag":"section","classes":["s_section-mist"],"children":["n0084","n0087"]},{"_id":"n0084","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0085"]},{"_id":"n0085","type":"Heading","tag":"h2","classes":["s_h-section-2"],"children":["n0086"],"data":{"tag":"h2"}},{"_id":"n0086","text":true,"v":"Why nonprofit delivery is genuinely different"},{"_id":"n0087","type":"Block","tag":"div","classes":["s_grid-3"],"children":["n0088","n0093","n0098"]},{"_id":"n0088","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0089","n0091"]},{"_id":"n0089","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0090"],"data":{"tag":"h3"}},{"_id":"n0090","text":true,"v":"Supporters, not customers"},{"_id":"n0091","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0092"]},{"_id":"n0092","text":true,"v":"A person can be a donor, a volunteer, a service user and a board member at once. A data model built for B2B sales handles that badly, and the damage shows up in the stewardship rather than in a report."},{"_id":"n0093","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0094","n0096"]},{"_id":"n0094","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0095"],"data":{"tag":"h3"}},{"_id":"n0095","text":true,"v":"Budget scrutiny is public"},{"_id":"n0096","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0097"]},{"_id":"n0097","text":true,"v":"Spending on systems is visible to funders and sometimes to media. Complimentary discovery, capped fees and paying only for days used are not niceties here, they are how the decision gets defended internally."},{"_id":"n0098","type":"Block","tag":"div","classes":["s_stack-2"],"children":["n0099","n0101"]},{"_id":"n0099","type":"Heading","tag":"h3","classes":["s_h-item"],"children":["n0100"],"data":{"tag":"h3"}},{"_id":"n0100","text":true,"v":"The mission argument is real"},{"_id":"n0101","type":"Paragraph","tag":"p","classes":["s_body"],"children":["n0102"]},{"_id":"n0102","text":true,"v":"Better supporter data means more money reaching the cause and less staff time on reconciliation. We will make that connection once, with numbers, and then get on with the build."},{"_id":"n0103","type":"Section","tag":"section","classes":["s_section"],"children":["n0104","n0107"]},{"_id":"n0104","type":"Block","tag":"div","classes":["s_col-2"],"children":["n0105"]},{"_id":"n0105","type":"Heading","tag":"h2","classes":["s_h-section-2"],"children":["n0106"],"data":{"tag":"h2"}},{"_id":"n0106","text":true,"v":"What Enable does here"},{"_id":"n0107","type":"Block","tag":"div","classes":["s_stack-4"],"children":["n0108","n0115","n0122","n0129"]},{"_id":"n0108","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0109","n0111","n0113"]},{"_id":"n0109","type":"Block","tag":"div","classes":["s_row"],"children":["n0110"]},{"_id":"n0110","text":true,"v":"01"},{"_id":"n0111","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0112"],"data":{"tag":"h3"}},{"_id":"n0112","text":true,"v":"Constituent and household modelling"},{"_id":"n0113","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0114"]},{"_id":"n0114","text":true,"v":"How people, households, organisations and relationships are represented, decided before anything is built. Almost every painful nonprofit implementation traces back to this being settled late."},{"_id":"n0115","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0116","n0118","n0120"]},{"_id":"n0116","type":"Block","tag":"div","classes":["s_row"],"children":["n0117"]},{"_id":"n0117","text":true,"v":"02"},{"_id":"n0118","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0119"],"data":{"tag":"h3"}},{"_id":"n0119","text":true,"v":"Fundraising process design"},{"_id":"n0120","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0121"]},{"_id":"n0121","text":true,"v":"Gift entry, recurring giving, designations, soft credits, acknowledgement and receipting, built to your actual finance process rather than to a reference diagram."},{"_id":"n0122","type":"Block","tag":"div","classes":["s_row-2"],"children":["n0123","n0125","n0127"]},{"_id":"n0123","type":"Block","tag":"div","classes":["s_row"],"children":["n0124"]},{"_id":"n0124","text":true,"v":"03"},{"_id":"n0125","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0126"],"data":{"tag":"h3"}},{"_id":"n0126","text":true,"v":"Programmes, cases and outcomes"},{"_id":"n0127","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0128"]},{"_id":"n0128","text":true,"v":"The delivery side modelled properly, including the sharing and confidentiality rules that client data in social services requires. This is where most partners stop and we do not."},{"_id":"n0129","type":"Block","tag":"div","classes":["s_row-8"],"children":["n0130","n0132","n0134"]},{"_id":"n0130","type":"Block","tag":"div","classes":["s_row"],"children":["n0131"]},{"_id":"n0131","text":true,"v":"04"},{"_id":"n0132","type":"Heading","tag":"h3","classes":["s_h-card"],"children":["n0133"],"data":{"tag":"h3"}},{"_id":"n0133","text":true,"v":"Licensing and the Power of Us discount"},{"_id":"n0134","type":"Paragraph","tag":"p","classes":["s_body-2"],"children":["n0135"]},{"_id":"n0135","text":true,"v":"Working out what you are actually entitled to, what the ten donated licences do and do not cover, and what the real annual cost looks like before you commit."},{"_id":"n0136","type":"Section","tag":"section","classes":["s_row-split-4"],"children":["n0137","n0139"]},{"_id":"n0137","type":"Block","tag":"div","classes":["s_wrap-11"],"children":["n0138"]},{"_id":"n0138","text":true,"v":"We work with"},{"_id":"n0139","type":"Block","tag":"div","classes":["s_row-wrap-2"],"children":["n0140","n0142","n0144","n0146","n0148"]},{"_id":"n0140","type":"Block","tag":"div","classes":["s_tag"],"children":["n0141"]},{"_id":"n0141","text":true,"v":"Charities"},{"_id":"n0142","type":"Block","tag":"div","classes":["s_tag"],"children":["n0143"]},{"_id":"n0143","text":true,"v":"Foundations and funders"},{"_id":"n0144","type":"Block","tag":"div","classes":["s_tag"],"children":["n0145"]},{"_id":"n0145","text":true,"v":"Social services"},{"_id":"n0146","type":"Block","tag":"div","classes":["s_tag"],"children":["n0147"]},{"_id":"n0147","text":true,"v":"Heritage and culture"},{"_id":"n0148","type":"Block","tag":"div","classes":["s_tag"],"children":["n0149"]},{"_id":"n0149","text":true,"v":"Membership bodies"},{"_id":"n0150","type":"Section","tag":"section","classes":["s_section-wash"],"children":["n0151","n0158"]},{"_id":"n0151","type":"Block","tag":"div","classes":["s_col-4"],"children":["n0152","n0154","n0156"]},{"_id":"n0152","type":"Heading","tag":"h2","classes":["s_h-cta"],"children":["n0153"],"data":{"tag":"h2"}},{"_id":"n0153","text":true,"v":"Tell us who your supporters are."},{"_id":"n0154","type":"Paragraph","tag":"p","classes":["s_body-md"],"children":["n0155"]},{"_id":"n0155","text":true,"v":"How you model people, households and giving decides most of what follows. It is worth an hour before anyone opens a builder."},{"_id":"n0156","type":"Paragraph","tag":"p","classes":["s_caption"],"children":["n0157"]},{"_id":"n0157","text":true,"v":"Blair Rooney, Managing Director. blair@enabledigital.co, +64 22 226 4252."},{"_id":"n0158","type":"Link","tag":"a","classes":["s_btn-primary"],"children":["n0159"],"data":{"link":{"mode":"external","url":"#top"}}},{"_id":"n0159","text":true,"v":"Book a conversation"},{"_id":"n0160","type":"Block","tag":"footer","classes":["s_stack-3"],"children":["n0161","n0208"]},{"_id":"n0161","type":"Block","tag":"div","classes":["s_row-7"],"children":["n0162","n0171"]},{"_id":"n0162","type":"Block","tag":"div","classes":["s_col-3"],"children":["n0163","n0164","n0166"]},{"_id":"n0163","type":"Block","tag":"div","classes":["s_col"],"children":[]},{"_id":"n0164","type":"Paragraph","tag":"p","classes":["s_body-sm"],"children":["n0165"]},{"_id":"n0165","text":true,"v":"A Salesforce consultancy in Auckland and Wellington, working across every layer of the stack